+function rotuloChavePassoCpf(chave) {
+  return String(chave)
+    .split("_")
+    .map((w) => w.charAt(0).toUpperCase() + w.slice(1))
+    .join(" ")
+}
+
+function formatarValorPassoCpf(chave, valor) {
+  if (valor == null) return "ÔÇö"
+  if (typeof valor === "boolean") return valor ? "Sim" : "N├úo"
+  if (typeof valor === "string") {
+    return valor.replace(/_/g, " ")
+  }
+  if (typeof valor === "number") {
+    const k = String(chave).toLowerCase()
+    if (k === "aliquota_nominal") {
+      return `${(valor * 100).toLocaleString("pt-BR", { maximumFractionDigits: 2 })}%`
+    }
+    if (k.includes("percent") || k.includes("aliquota_efetiva")) {
+      return `${valor.toLocaleString("pt-BR", { maximumFractionDigits: 4 })}%`
+    }
+    return `R$ ${valor.toLocaleString("pt-BR", { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`
+  }
+  return String(valor)
+}
