+        "scope_ratified": SCHEMA,
+        "g12_xml_parser_v41_tests_passed": 7,
+        "g12_v4_historical_tests_passed": 6,
+        "enterprise_g1_original_tests_passed": 22,
+        "enterprise_g1_coexistence_tests_passed": 8,
+        "GLOBAL_GREEN": False,
+    })
+    return result
+
+
+def run(args: argparse.Namespace) -> dict:
+    repo = args.repo.resolve()
+    if v2._git(repo, "branch", "--show-current") != v2.RECOVERY_BRANCH:
+        raise v2.RecoveryGateError("WRONG_RECOVERY_BRANCH")
+    if v2._git(repo, "rev-parse", v2.BASELINE_SHA) != v2.BASELINE_SHA:
+        raise v2.RecoveryGateError("BASELINE_COMMIT_UNAVAILABLE")
+    try:
+        env = {"python": platform.python_version(), "fastapi": version("fastapi"),
+               "pydantic": version("pydantic")}
+    except PackageNotFoundError as exc:
+        raise v2.RecoveryGateError("TEST_DEPENDENCIES_NOT_INSTALLED") from exc
+    v2_manifest = repo / "docs/B03_B04_BASELINE_ESCOPO_TRANSACIONAL_V2_20261118.json"
+    v3_manifest = repo / "docs/B03_B04_BASELINE_ESCOPO_G1_V3_20261118.json"
+    v4_manifest = repo / "docs/B03_B04_BASELINE_ESCOPO_G12_V4_20261118.json"
+    approved_v2 = json.loads(v2_manifest.read_text(encoding="utf-8"))
+    approved_v3 = json.loads(v3_manifest.read_text(encoding="utf-8"))
+    approved_v4 = json.loads(v4_manifest.read_text(encoding="utf-8"))
+    approved_v41 = json.loads(args.approved_manifest.read_text(encoding="utf-8"))
+    if approved_v2.get("environment") != env:
+        raise v2.RecoveryGateError("TEST_ENVIRONMENT_DRIFT")
+    v2._verify_junit_digest(args.baseline_junit, approved_v2["baseline_junit_sha256"])
+    changed = set(v2._git(repo, "diff", "--name-only", v2.BASELINE_SHA).splitlines())
+    changed.update(v2._git(repo, "ls-files", "--others", "--exclude-standard").splitlines())
+    observed = {p: v2._git(repo, "hash-object", p) for p in PINNED}
+    harness = {p: v2._git(repo, "hash-object", p) for p in v2.BASELINE_HARNESS_OVERLAY}
+    return evaluate_v41(
+        repo=repo, baseline=v2.parse_junit(args.baseline_junit),
+        candidate=v2.parse_junit(args.candidate_junit),
+        approved_v2=approved_v2, approved_v3=approved_v3, approved_v4=approved_v4,
+        approved_v41=approved_v41, changed=changed,
+        observed=observed, harness=harness,
+    )
+
+
+def main(argv=None) -> int:
+    p = argparse.ArgumentParser(description=__doc__)
+    p.add_argument("--repo", type=Path, default=Path("."))
+    p.add_argument("--baseline-junit", type=Path, required=True)
+    p.add_argument("--candidate-junit", type=Path, required=True)
+    p.add_argument("--approved-manifest", type=Path, required=True)
+    p.add_argument("--output", type=Path, required=True)
+    a = p.parse_args(argv)
+    try:
+        result = run(a)
+    except (v2.RecoveryGateError, OSError, json.JSONDecodeError, KeyError,
+            ValueError, TypeError) as exc:
+        result = {
+            "schema_version": "SOLVERIS_ENTERPRISE_RECOVERY_GATE_V41",
+            "GLOBAL_GREEN": False,
+            "ENTERPRISE_RECOVERY_STATUS": "BLOCKED",
+            "reason": str(exc).split(":", 1)[0],
+        }
+    a.output.parent.mkdir(parents=True, exist_ok=True)
+    a.output.write_text(json.dumps(result, ensure_ascii=False, indent=2) + "\n",
+                        encoding="utf-8")
+    print(result["ENTERPRISE_RECOVERY_STATUS"])
+    return 0 if result["ENTERPRISE_RECOVERY_STATUS"] == "PASS_WITH_BASELINE_RED" else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())

