diff --git a/tests/test_enterprise_g12_xml_parser_v41_contract.py b/tests/test_enterprise_g12_xml_parser_v41_contract.py
new file mode 100644
index 00000000..4d2fcf95
--- /dev/null
+++ b/tests/test_enterprise_g12_xml_parser_v41_contract.py
@@ -0,0 +1,150 @@
+"""V4.1: comparacao XML-parser geral; amostra RS independente da B01 PR.
+
+Nao altera fixture historica. So SQLite in-memory, sem rede, escrita real
+externa ou norma oficial. O segundo cenario usa UF/NCM, ID e valores novos.
+"""
+from __future__ import annotations
+
+from datetime import date
+from types import SimpleNamespace
+from unittest import TestCase
+from unittest.mock import patch
+
+from defusedxml import ElementTree as ET
+from sqlalchemy import create_engine
+from sqlalchemy.orm import sessionmaker
+
+from app.database import Base
+from app.models import TabelaMVA
+from app.xml_service import ler_xml_unico
+from app.services import enterprise_g12_st_item_reconciliation as g12
+
+UF = "RS"
+NCM = "30049099"
+SOURCE = "ATO SINTETICO DE TESTE NAO OFICIAL"
+URL = "https://www.sefaz.rs.gov.br/exemplo-sintetico-g12-v41.pdf"
+KEY = "2" * 44
+
+
+def _xml_independente(*, base_st="280.00", icms_st="13.60") -> bytes:
+    # Novo exemplo: R$200, alíquota 17%, MVA 40%, ICMS próprio R$34,
+    # base ST R$280, ICMS ST R$13,60. Nenhum valor deriva do B01 PR.
+    return f'''<NFe xmlns="http://www.portalfiscal.inf.br/nfe">
+  <infNFe Id="NFe{KEY}"><ide><mod>55</mod><tpNF>1</tpNF>
+    <finNFe>1</finNFe><idDest>1</idDest>
+    <dhEmi>2026-05-03T09:00:00-03:00</dhEmi></ide>
+    <emit><CNPJ>22345678000199</CNPJ><enderEmit><UF>{UF}</UF></enderEmit></emit>
+    <dest><enderDest><UF>{UF}</UF></enderDest></dest>
+    <det nItem="1"><prod><NCM>{NCM}</NCM><CFOP>5102</CFOP>
+      <qCom>1</qCom><vProd>200.00</vProd></prod>
+      <imposto><ICMS><ICMS10><CST>10</CST><modBCST>4</modBCST>
+        <vBC>200.00</vBC><pICMS>17.00</pICMS><vICMS>34.00</vICMS>
+        <vBCST>{base_st}</vBCST><vICMSST>{icms_st}</vICMSST>
+      </ICMS10></ICMS></imposto></det>
+    <total><ICMSTot><vNF>200.00</vNF></ICMSTot></total>
+  </infNFe></NFe>'''.encode("utf-8")
+
+
+class TestEnterpriseG12XmlParserV41(TestCase):
+    def setUp(self):
+        self.engine = create_engine("sqlite+pysqlite:///:memory:")
+        Base.metadata.create_all(self.engine, tables=[TabelaMVA.__table__])
+        self.db = sessionmaker(bind=self.engine, expire_on_commit=False)()
+        self.db.add(TabelaMVA(
+            id=191, estado=UF, ncm=NCM, mva=0.4, aliquota_interna=0.17,
+            vigencia_inicio=date(2026, 5, 1), vigencia_fim=None,
+            fonte_legal=SOURCE, nivel_confianca_fonte="oficial",
+            url_fonte=URL, importado_por="B01_SYNTHETIC_FIXTURE",
+        ))
+        self.db.commit()
+        self.raw = _xml_independente()
+
+    def tearDown(self):
+        self.db.close()
+        self.engine.dispose()
+
+    def item(self, raw=None):
+        out = g12.confrontar_st_por_item_g12(
+            db=self.db, xml_bytes=self.raw if raw is None else raw
+        )
+        return out, out["itens"][0]
+
+    def test_01_segundo_cenario_rs_valores_novos_simula_sem_autoridade(self):
+        out, item = self.item()
+        self.assertEqual(out["itens_simulados"], 1)
+        self.assertEqual(item["estado"], "SIMULACAO_CONDICIONAL_MVA")
+        self.assertEqual(item["rastro_parametros_g12_v1"]["base_st_motor"], "280.0")
+        self.assertEqual(item["rastro_parametros_g12_v1"]["icms_st_motor"], "13.6")
+        self.assertEqual(item["proveniencia_l2_g12_v1"]["registro_mva_id"], 191)
+        self.assertEqual(
+            item["motivo"], "G12_OBSERVACAO_SINTETICA_FORA_PILOTO_SEM_AUTORIDADE"
+        )
+        for key in ("autoridade_fiscal", "credito_confirmado", "checkout_autorizado",
+                    "usavel_comercialmente"):
+            self.assertIs(out[key], False)
+
+    def test_02_comparacao_xml_parser_geral_sem_marcador_b01(self):
+        doc = ET.fromstring(self.raw)
+        ns = {"n": "http://www.portalfiscal.inf.br/nfe"}
+        group = doc.find(".//n:ICMS10", ns)
+        parsed = ler_xml_unico(xml_bytes=self.raw)["itens"][0]
+        self.assertNotIn("st_observado_xml", parsed)
+        self.assertTrue(g12._st_xml_parser_conciliado(group, parsed))
+        # A regra de igualdade nem recebe DB, UF, NCM, ID ou marcador.
+        self.assertTrue(g12._st_xml_parser_conciliado(
+            group, {"base_st": "280", "valor_st": "13.6"}
+        ))
+
+    def test_03_marcador_ausente_mantem_bloqueio_normativo_rs(self):
+        row = self.db.get(TabelaMVA, 191)
+        row.importado_por = "OUTRA_PROVENIENCIA"
+        self.db.commit()
+        out, item = self.item()
+        self.assertEqual(out["itens_simulados"], 0)
+        self.assertEqual(item["motivo"], "G12_REGRA_NAO_AUTORIZADA_PELO_RESOLVEDOR")
+        self.assertFalse(out["checkout_autorizado"])
+
+    def test_04_st_xml_ausente_falha_fechado(self):
+        raw = self.raw.replace(b"<vBCST>280.00</vBCST>", b"")
+        out, item = self.item(raw)
+        self.assertEqual(out["itens_simulados"], 0)
+        self.assertEqual(item["motivo"], "G12_ST_XML_PARSER_AUSENTE_OU_DIVERGENTE")
+
+    def test_05_st_xml_valor_ausente_falha_fechado(self):
+        raw = self.raw.replace(b"<vICMSST>13.60</vICMSST>", b"")
+        out, item = self.item(raw)
+        self.assertEqual(out["itens_simulados"], 0)
+        self.assertEqual(item["motivo"], "G12_ST_XML_PARSER_AUSENTE_OU_DIVERGENTE")
+
+    def test_06_divergencia_parser_real_vs_xml_falha_fechado(self):
+        real_parser = g12.ler_xml_unico
+
+        def adulterar_um_valor(*, xml_bytes):
+            parsed = real_parser(xml_bytes=xml_bytes)
+            parsed["itens"][0]["valor_st"] = "99.99"
+            return parsed
+
+        with patch.object(g12, "ler_xml_unico", side_effect=adulterar_um_valor):
+            out, item = self.item()
+        self.assertEqual(out["itens_simulados"], 0)
+        self.assertEqual(item["motivo"], "G12_ST_XML_PARSER_AUSENTE_OU_DIVERGENTE")
+        self.assertFalse(out["autoridade_fiscal"])
+
+    def test_07_sqlite_em_disco_nao_serve_como_prova_sintetica(self):
+        disk = SimpleNamespace(
+            get_bind=lambda: SimpleNamespace(
+                dialect=SimpleNamespace(name="sqlite"),
+                url=SimpleNamespace(database="outro.sqlite"),
+            )
+        )
+        norm = dict(
+            fonte_legal=SOURCE, nivel_confianca_fonte="oficial"
+        )
+        self.assertIsNone(
+            g12._linha_sintetica_observavel(disk, UF, NCM, date(2026, 5, 3), norm)
+        )
+
+
+if __name__ == "__main__":
+    import unittest
+    unittest.main()

