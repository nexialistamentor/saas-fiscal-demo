@@ -0,0 +1,99 @@
+"""Controlos do gate V4.1. Aprovacao nao decorre de contagem de testes."""
+from __future__ import annotations
+
+import importlib.util
+import json
+from pathlib import Path
+import unittest
+from unittest.mock import patch
+
+ROOT = Path(__file__).resolve().parents[1]
+SPEC = importlib.util.spec_from_file_location(
+    "enterprise_v41_gate_under_test",
+    ROOT / "tools/enterprise_recovery_test_gate_v41.py",
+)
+assert SPEC and SPEC.loader
+gate = importlib.util.module_from_spec(SPEC)
+SPEC.loader.exec_module(gate)
+
+
+class TestRecoveryGateV41(unittest.TestCase):
+    def setUp(self):
+        self.v41 = json.loads((ROOT / gate.MANIFEST).read_text(encoding="utf-8"))
+
+    def test_01_manifesto_v41_exato_sem_green(self):
+        gate._validate_manifest(ROOT, self.v41, require_commit=False)
+        self.assertIs(self.v41["GLOBAL_GREEN"], False)
+
+    def test_02_global_green_true_reprovado(self):
+        with self.assertRaisesRegex(gate.v2.RecoveryGateError,
+                                    "SCOPE_V41_UNRATIFIED_OR_EXPANDED"):
+            gate._validate_manifest(ROOT, dict(self.v41, GLOBAL_GREEN=True),
+                                    require_commit=False)
+
+    def test_03_manifesto_alterado_reprovado(self):
+        with self.assertRaisesRegex(gate.v2.RecoveryGateError,
+                                    "SCOPE_V41_MANIFEST_FINGERPRINT_DIVERGED"):
+            gate._validate_manifest(ROOT, dict(self.v41, status="FALSO"),
+                                    require_commit=False)
+
+    def test_04_manifesto_nao_commitado_reprovado(self):
+        old = gate.v2._git
+
+        def fake_git(repo, *args):
+            if args == ("rev-parse", "HEAD:" + gate.MANIFEST):
+                return "0" * 40
+            return old(repo, *args)
+
+        with patch.object(gate.v2, "_git", side_effect=fake_git):
+            with self.assertRaisesRegex(gate.v2.RecoveryGateError,
+                                        "SCOPE_V41_MANIFEST_UNCOMMITTED"):
+                gate._validate_manifest(ROOT, self.v41)
+
+    def test_05_caminho_fora_do_escopo_reprovado(self):
+        v3 = json.loads(
+            (ROOT / "docs/B03_B04_BASELINE_ESCOPO_G1_V3_20261118.json")
+            .read_text(encoding="utf-8")
+        )
+        v4 = json.loads(
+            (ROOT / "docs/B03_B04_BASELINE_ESCOPO_G12_V4_20261118.json")
+            .read_text(encoding="utf-8")
+        )
+        with self.assertRaisesRegex(gate.v2.RecoveryGateError,
+                                    "SCOPE_V41_UNAPPROVED_PATH_CHANGED"):
+            gate.verify_sources(
+                repo=ROOT, v3_manifest=v3, v4_manifest=v4,
+                v41_manifest=self.v41, changed={"app/mei/rotas.py"},
+                observed=self.v41["candidate_source_blobs"],
+            )
+
+    def test_06_novo_red_bloqueia_v41(self):
+        v3 = json.loads(
+            (ROOT / "docs/B03_B04_BASELINE_ESCOPO_G1_V3_20261118.json")
+            .read_text(encoding="utf-8")
+        )
+        v4 = json.loads(
+            (ROOT / "docs/B03_B04_BASELINE_ESCOPO_G12_V4_20261118.json")
+            .read_text(encoding="utf-8")
+        )
+        with patch.object(gate, "_validate_manifest"):
+            with patch.object(gate, "verify_sources"):
+                with patch.object(gate, "_required_v41_nodes", return_value={"NOVO::RED"}):
+                    with self.assertRaisesRegex(gate.v2.RecoveryGateError,
+                                                "SCOPE_V41_TESTS_RED"):
+                        gate.evaluate_v41(
+                            repo=ROOT, baseline={}, candidate={"NOVO::RED": ("failure", "", "")},
+                            approved_v2={}, approved_v3=v3, approved_v4=v4,
+                            approved_v41=self.v41, changed=set(), observed={},
+                            harness={}, require_commit=False,
+                        )
+
+    def test_07_heranca_dos_54_controles_e_novos_nodos(self):
+        nodes = gate._required_v41_nodes(ROOT)
+        self.assertEqual(len(nodes), 22 + 8 + 8 + 6 + 7 + 7 + 7 + 5)
+        self.assertTrue(any("test_01_segundo_cenario_rs" in n for n in nodes))
+        self.assertTrue(any("test_v41_versao_anterior_rejeitada" in n for n in nodes))
+
+
+if __name__ == "__main__":
+    unittest.main()

diff --git a/tests/test_enterprise_recovery_v41_history_gate.py b/tests/test_enterprise_recovery_v41_history_gate.py
