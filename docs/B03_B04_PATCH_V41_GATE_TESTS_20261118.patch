index 00000000..74b503e7
--- /dev/null
+++ b/tools/enterprise_recovery_test_gate_v41.py
@@ -0,0 +1,277 @@
+"""V4.1: G12 XML-parser geral + observacao sintetica, sem falso GREEN.
+
+O gate V3 e o V4 originais permanecem inalterados e devem bloquear G12 V4.1.
+Somente este gate compara o G12 actual diretamente com o novo manifesto.
+"""
+from __future__ import annotations
+
+import argparse
+import importlib.util
+import json
+import platform
+import subprocess
+import sys
+from importlib.metadata import PackageNotFoundError, version
+from pathlib import Path
+
+_spec = importlib.util.spec_from_file_location(
+    "enterprise_recovery_v4_for_v41",
+    Path(__file__).with_name("enterprise_recovery_test_gate_v4.py"),
+)
+assert _spec and _spec.loader
+v4 = importlib.util.module_from_spec(_spec)
+_spec.loader.exec_module(v4)
+v3 = v4.v3
+v2 = v4.v2
+
+SCHEMA = "SOLVERIS_ENTERPRISE_RECOVERY_G12_SCOPE_V41"
+MANIFEST = "docs/B03_B04_BASELINE_ESCOPO_G12_V41_20261118.json"
+V4_MANIFEST_BLOB = "864c0a82ce9df1e70b43ab8931b8c307af13646e"
+V4_G12_BLOB = "4a782490cf8fd6d6b9d2d6d7b801370cbe6e2ea0"
+G12_V41_BLOB = "13ef36fe50ed55086092ca81b3c5f7f2c4ec07ae"
+MANIFEST_FINGERPRINT = "e68535badb860dc8827afb21127f42afb90a966d022d16b46f45bfc9f81fd567"
+EXTRA = frozenset({
+    "docs/B03_B04_STOP_G12_V4_ST_OBSERVADO_XML_20261118.md",
+    "docs/B03_B04_BASELINE_ESCOPO_G12_V41_20261118.json",
+    "docs/B03_B04_PATCH_G12_V41_PRODUTO_20261118.patch",
+    "docs/B03_B04_PATCH_V41_GATE_TESTS_20261118.patch",
+    "docs/B03_B04_EXECUCAO_G12_V41_20261118.md",
+    "tests/test_enterprise_g12_xml_parser_v41_contract.py",
+    "tests/test_enterprise_recovery_scope_v41_gate.py",
+    "tests/test_enterprise_recovery_v41_history_gate.py",
+    "tools/enterprise_recovery_test_gate_v41.py",
+})
+OVERRIDES = frozenset({
+    "app/services/enterprise_g12_st_item_reconciliation.py",
+    "tests/recovery_v3_snapshot_guard.py",
+})
+NEW_TESTS = {
+    "tests.test_enterprise_g12_xml_parser_v41_contract.TestEnterpriseG12XmlParserV41": 7,
+    "tests.test_enterprise_recovery_scope_v41_gate.TestRecoveryGateV41": 7,
+    "tests.test_enterprise_recovery_v41_history_gate.TestRecoveryV41Historical": 5,
+}
+PINNED = frozenset({
+    "tests/recovery_v3_snapshot_guard.py",
+    "tests/test_enterprise_g12_xml_parser_v41_contract.py",
+    "tests/test_enterprise_recovery_scope_v41_gate.py",
+    "tests/test_enterprise_recovery_v41_history_gate.py",
+    "docs/B03_B04_PATCH_G12_V41_PRODUTO_20261118.patch",
+})
+
+
+def _fingerprint(value):
+    copy = dict(value)
+    copy.pop("gate_self_blob", None)
+    return v2._canonical_digest(copy)
+
+
+def _required_v41_nodes(repo: Path) -> set[str]:
+    required = v4._required_v4_nodes(repo)
+    for prefix, count in NEW_TESTS.items():
+        module, classname = prefix.rsplit(".", 1)
+        names = v3._test_names(
+            repo / (module.replace(".", "/") + ".py"), classname, ""
+        )
+        if len(names) != count:
+            raise v2.RecoveryGateError("SCOPE_V41_TEST_COUNT_DIVERGENCE")
+        required.update(prefix + "::" + name for name in names)
+    return required
+
+
+def _validate_manifest(repo: Path, data: dict, *, require_commit: bool = True) -> None:
+    if (data.get("schema_version") != SCHEMA
+            or data.get("GLOBAL_GREEN") is not False
+            or data.get("parent_v4_manifest_blob") != V4_MANIFEST_BLOB
+            or data.get("preserved_v4_g12_blob") != V4_G12_BLOB
+            or data.get("candidate_g12_blob") != G12_V41_BLOB
+            or data.get("extra_paths") != sorted(EXTRA)
+            or data.get("modified_v4_paths") != sorted(OVERRIDES)
+            or set(data.get("candidate_source_blobs", {})) != PINNED):
+        raise v2.RecoveryGateError("SCOPE_V41_UNRATIFIED_OR_EXPANDED")
+    if _fingerprint(data) != MANIFEST_FINGERPRINT:
+        raise v2.RecoveryGateError("SCOPE_V41_MANIFEST_FINGERPRINT_DIVERGED")
+    if require_commit:
+        if (v2._git(repo, "hash-object", MANIFEST)
+                != v2._git(repo, "rev-parse", "HEAD:" + MANIFEST)):
+            raise v2.RecoveryGateError("SCOPE_V41_MANIFEST_UNCOMMITTED")
+
+
+def verify_sources(
+    *, repo: Path, v3_manifest: dict, v4_manifest: dict,
+    v41_manifest: dict, changed: set[str], observed: dict[str, str],
+) -> None:
+    allowed = (v4.v2_manifest_paths(repo) | set(v3.V3_DELTA)
+               | set(v4.V4_DELTA) | set(EXTRA))
+    if changed - allowed:
+        raise v2.RecoveryGateError("SCOPE_V41_UNAPPROVED_PATH_CHANGED")
+    if not (set(v3.V3_DELTA) | set(v4.V4_DELTA) | set(EXTRA) |
+            set(OVERRIDES)).issubset(changed):
+        raise v2.RecoveryGateError("SCOPE_V41_REQUIRED_PATH_MISSING")
+    if observed != v41_manifest["candidate_source_blobs"]:
+        raise v2.RecoveryGateError("SCOPE_V41_SOURCE_BLOB_DIVERGENCE")
+    if (v2._git(repo, "hash-object", "tests/test_solveris_b01_circuit.py")
+            != v4.ORIGINAL_B01_BLOB):
+        raise v2.RecoveryGateError("SCOPE_V41_B01_CONTRACT_CHANGED")
+    if (v2._git(repo, "hash-object",
+                "app/services/enterprise_g12_st_item_reconciliation.py")
+            != G12_V41_BLOB):
+        raise v2.RecoveryGateError("SCOPE_V41_G12_SOURCE_DIVERGED")
+    if (v2._git(repo, "hash-object", "tools/enterprise_recovery_test_gate_v41.py")
+            != v41_manifest["gate_self_blob"]):
+        raise v2.RecoveryGateError("SCOPE_V41_GATE_SOURCE_DIVERGED")
+    if (v2._git(repo, "hash-object", "tools/enterprise_recovery_test_gate_v4.py")
+            != v4_manifest["gate_self_blob"]):
+        raise v2.RecoveryGateError("SCOPE_V41_ORIGINAL_GATE_V4_CHANGED")
+    if (v2._git(repo, "hash-object",
+                "app/services/tax_consistency/tax_consistency_engine.py")
+            != v3.SHARED_G1_BLOB):
+        raise v2.RecoveryGateError("SCOPE_V41_SHARED_G1_CHANGED")
+    for path, old in v3_manifest["candidate_source_blobs"].items():
+        target = G12_V41_BLOB if path == (
+            "app/services/enterprise_g12_st_item_reconciliation.py"
+        ) else old
+        if v2._git(repo, "hash-object", path) != target:
+            raise v2.RecoveryGateError("SCOPE_V41_V3_SOURCE_CHANGED:" + path)
+    for path, old in v4_manifest["candidate_source_blobs"].items():
+        target = observed[path] if path in OVERRIDES else old
+        if v2._git(repo, "hash-object", path) != target:
+            raise v2.RecoveryGateError("SCOPE_V41_V4_SOURCE_CHANGED:" + path)
+    v3.verify_historical_source(repo)
+
+    provenance = json.loads(
+        (repo / "docs/B03_B04_BLOB_PROVENIENCE_20261118.json").read_text(
+            encoding="utf-8"
+        )
+    )
+    entries = provenance.get("items", [])
+    if (len(entries) != 36 or
+            len({x.get("path") for x in entries if type(x) is dict}) != 36):
+        raise v2.RecoveryGateError("SCOPE_V41_PROVENANCE_COUNT_INVALID")
+    for row in entries:
+        path = row["path"]
+        expected = (
+            G12_V41_BLOB if path == "app/services/enterprise_g12_st_item_reconciliation.py"
+            else v3_manifest["candidate_source_blobs"][path] if path in v3.V3_OVERRIDES
+            else row["git_blob"]
+        )
+        if v2._git(repo, "hash-object", path) != expected:
+            raise v2.RecoveryGateError("SCOPE_V41_PROVENANCE_CHANGED:" + path)
+    check = subprocess.run(
+        [sys.executable, str(repo / "tools/check_duplicacao.py"),
+         "--repo", str(repo), "--registro", "docs/REGISTRO_CANONICO.json"],
+        cwd=repo, capture_output=True, text=True, check=False,
+    )
+    if check.returncode:
+        raise v2.RecoveryGateError("SCOPE_V41_DUPLICATION_CHECK_FAILED")
+
+
+def evaluate_v41(
+    *, repo: Path, baseline: dict, candidate: dict,
+    approved_v2: dict, approved_v3: dict, approved_v4: dict,
+    approved_v41: dict, changed: set[str], observed: dict[str, str],
+    harness: dict[str, str], require_commit: bool = True,
+) -> dict:
+    _validate_manifest(repo, approved_v41, require_commit=require_commit)
+    if (v2._git(repo, "hash-object",
+                "docs/B03_B04_BASELINE_ESCOPO_G12_V4_20261118.json")
+            != V4_MANIFEST_BLOB
+            or v4._ratified_fingerprint(approved_v4)
+            != v4.RATIFIED_MANIFEST_FINGERPRINT):
+        raise v2.RecoveryGateError("SCOPE_V41_PARENT_V4_CHANGED")
+    if (v2._git(repo, "hash-object",
+                "docs/B03_B04_BASELINE_ESCOPO_G1_V3_20261118.json")
+            != v4.PARENT_V3_BLOB
+            or v2._canonical_digest(approved_v3) != v3.MANIFEST_FINGERPRINT):
+        raise v2.RecoveryGateError("SCOPE_V41_PARENT_V3_CHANGED")
+    if (v2._git(repo, "hash-object",
+                "docs/B03_B04_BASELINE_ESCOPO_TRANSACIONAL_V2_20261118.json")
