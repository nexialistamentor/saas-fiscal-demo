@@ -0,0 +1,78 @@
+"""Provas test-only de sucessao historica G12 V3 -> V4 -> V4.1."""
+from __future__ import annotations
+
+import importlib.util
+import json
+from pathlib import Path
+import unittest
+from unittest.mock import patch
+
+from recovery_v3_snapshot_guard import (
+    TARGET, V4_G12_BLOB, V4_MANIFEST, V4_MANIFEST_BLOB,
+    V41_MANIFEST, V41_SCHEMA, historical_v3_test_context,
+    verify_v41_predecessor,
+)
+
+ROOT = Path(__file__).resolve().parents[1]
+SPEC = importlib.util.spec_from_file_location(
+    "historical_v41_gate", ROOT / "tools/enterprise_recovery_test_gate_v3.py"
+)
+assert SPEC and SPEC.loader
+gate = importlib.util.module_from_spec(SPEC)
+SPEC.loader.exec_module(gate)
+
+
+class TestRecoveryV41Historical(unittest.TestCase):
+    def test_v41_sucessao_real_verificada(self):
+        live = gate.v2._git(ROOT, "hash-object", TARGET)
+        self.assertNotEqual(live, V4_G12_BLOB)
+        verify_v41_predecessor(gate, ROOT, live)
+        with historical_v3_test_context(gate, ROOT):
+            self.assertEqual(
+                gate.v2._git(ROOT, "hash-object", TARGET),
+                "7b70bd28af292dc8028d572336b80f22bac0a945",
+            )
+
+    def test_v41_versao_anterior_rejeitada(self):
+        with self.assertRaisesRegex(gate.v2.RecoveryGateError,
+                                    "V41_G12_SOURCE_NOT_RATIFIED"):
+            verify_v41_predecessor(gate, ROOT, V4_G12_BLOB)
+
+    def test_v41_manifesto_inexistente_rejeitado(self):
+        original_is_file = Path.is_file
+
+        def missing(file):
+            return False if str(file).endswith(V41_MANIFEST) else original_is_file(file)
+
+        with patch.object(Path, "is_file", autospec=True, side_effect=missing):
+            with self.assertRaisesRegex(gate.v2.RecoveryGateError,
+                                        "V41_RATIFIED_MANIFEST_MISSING"):
+                verify_v41_predecessor(gate, ROOT, "1" * 40)
+
+    def test_v41_parent_v4_modificado_rejeitado(self):
+        original_git = gate.v2._git
+
+        def replaced(root, *args):
+            if args == ("hash-object", V4_MANIFEST):
+                return "0" * 40
+            return original_git(root, *args)
+
+        with patch.object(gate.v2, "_git", side_effect=replaced):
+            with self.assertRaisesRegex(gate.v2.RecoveryGateError,
+                                        "V41_PARENT_V4_BLOB_DIVERGED"):
+                verify_v41_predecessor(gate, ROOT, "1" * 40)
+
+    def test_v41_manifesto_v4_intocado_e_nao_green(self):
+        self.assertEqual(gate.v2._git(ROOT, "hash-object", V4_MANIFEST),
+                         V4_MANIFEST_BLOB)
+        old = json.loads((ROOT / V4_MANIFEST).read_text(encoding="utf-8"))
+        new = json.loads((ROOT / V41_MANIFEST).read_text(encoding="utf-8"))
+        self.assertEqual(old["candidate_g12_blob"], V4_G12_BLOB)
+        self.assertEqual(new["schema_version"], V41_SCHEMA)
+        self.assertEqual(new["parent_v4_manifest_blob"], V4_MANIFEST_BLOB)
+        self.assertIs(old["GLOBAL_GREEN"], False)
+        self.assertIs(new["GLOBAL_GREEN"], False)
+
+
+if __name__ == "__main__":
+    unittest.main()

diff --git a/tools/enterprise_recovery_test_gate_v41.py b/tools/enterprise_recovery_test_gate_v41.py
