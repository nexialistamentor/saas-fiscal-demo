+        baseline=baseline, candidate=candidate, approved=approved_v2,
+        contract_hashes={p: v2._git(repo, "hash-object", p) for p in v2.PROTECTED},
+        changed_paths=changed - set(v3.V3_DELTA) - set(v4.V4_DELTA) - set(EXTRA),
+        harness_hashes=harness,
+    )
