+"""Executa os 22 testes G1 originais sem alterar o blob test-only de origem.
+
+Origem c9a17fd1:tests/test_enterprise_g1_consistencia_causal_item.py
+Git blob imutável: 45a2080a8adead467aa4b00275e3a33616b0966c.
+O arquivo histórico local não começa por test_ e não é recolhido em duplicado.
+"""
+from __future__ import annotations
+
+import importlib.util
+from pathlib import Path
+
+from app.services.enterprise_tax_consistency.enterprise_tax_consistency_engine import (
+    EnterpriseTaxConsistencyEngine,
+)
+
+_HISTORICAL = Path(__file__).with_name("enterprise_g1_contract_origin.py")
+_spec = importlib.util.spec_from_file_location("_enterprise_g1_original_contract", _HISTORICAL)
+assert _spec is not None and _spec.loader is not None
+_original = importlib.util.module_from_spec(_spec)
+_spec.loader.exec_module(_original)
+
+# Apenas a referência E do teste original muda. Métodos/asserções/fixtures
+# permanecem byte por byte no ficheiro original custodiado em Git.
+_original.E = EnterpriseTaxConsistencyEngine
+
+
+class TestEnterpriseG1PrivateOriginalContract(_original.TestG1):
+    """Os 22 contratos de G1, agora ligados exclusivamente ao comparador privado."""
