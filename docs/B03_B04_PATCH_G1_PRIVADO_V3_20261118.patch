@@ -0,0 +1,91 @@
+"""Catraca de coexistência deliberada: não relaxar anti-duplicação do projeto."""
+from __future__ import annotations
+
+import copy
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+import unittest
+
+
+ROOT = Path(__file__).resolve().parents[1]
+REGISTRY = ROOT / "docs/REGISTRO_CANONICO.json"
+CHECKER = ROOT / "tools/check_duplicacao.py"
+SPEC = importlib.util.spec_from_file_location("enterprise_duplicate_checker", CHECKER)
+assert SPEC is not None and SPEC.loader is not None
+checker = importlib.util.module_from_spec(SPEC)
+SPEC.loader.exec_module(checker)
+
+MODULES = ["app/services/tax_consistency", "app/services/enterprise_tax_consistency"]
+NEW_ID = "comparador_consistencia_enterprise_g1"
+ORIGINAL_G1_TEST_BLOB = "45a2080a8adead467aa4b00275e3a33616b0966c"
+
+
+class TestEnterpriseG1CoexistenceGate(unittest.TestCase):
+    def setUp(self):
+        self.registry = json.loads(REGISTRY.read_text(encoding="utf-8"))
+
+    def private(self):
+        return next(entry for entry in self.registry["modulos"] if entry["id"] == NEW_ID)
+
+    def findings(self):
+        return checker.verificar(ROOT, self.registry, MODULES)
+
+    def test_coexistencia_ratificada_sem_substituir_legacy(self):
+        self.assertEqual(self.findings(), [])
+        self.assertEqual(self.private()["substitui"], [])
+        self.assertEqual(self.private()["coexiste_com"], ["comparador_consistencia"])
+
+    def test_sem_registo_explicito_bloqueia_duplicacao(self):
+        self.registry["modulos"].remove(self.private())
+        self.assertTrue(any("SUSPEITO" in item for item in self.findings()))
+
+    def test_falsa_coexistencia_bloqueia(self):
+        self.private()["coexiste_com"] = ["motor_calculo_numerico"]
+        self.assertTrue(any("COEXISTENCIA_INVALIDA" in item for item in self.findings()))
+
+    def test_proveniencia_adulterada_bloqueia(self):
+        self.private()["origem_git_blob"] = "0" * 40
+        self.assertTrue(any("COEXISTENCIA_INVALIDA" in item for item in self.findings()))
+
+    def test_substituicao_ficticia_de_legacy_bloqueia(self):
+        original = next(m for m in self.registry["modulos"] if m["id"] == "comparador_consistencia")
+        original["substitui"] = [self.private()["modulo_canonico"]]
+        self.assertTrue(any("COEXISTENCIA_INVALIDA" in item for item in self.findings()))
+
+    def test_terceira_coexistencia_generica_bloqueia(self):
+        intruso = copy.deepcopy(self.private())
+        intruso["id"] = "comparador_nao_ratificado"
+        intruso["modulo_canonico"] = "app/services/enterprise_fake/fake.py"
+        self.registry["modulos"].append(intruso)
+        self.assertTrue(any("COEXISTENCIA_INVALIDA" in item for item in self.findings()))
+
+    def test_22_testes_originais_preservados_bit_a_bit(self):
+        original = (ROOT / "tests/enterprise_g1_contract_origin.py").read_bytes()
+        blob = hashlib.sha1(b"blob " + str(len(original)).encode() + b"\0" + original).hexdigest()
+        self.assertEqual(blob, ORIGINAL_G1_TEST_BLOB)
+
+    def test_motor_partilhado_manteve_blob_main(self):
+        original = (ROOT / "app/services/tax_consistency/tax_consistency_engine.py").read_bytes()
+        blob = hashlib.sha1(b"blob " + str(len(original)).encode() + b"\0" + original).hexdigest()
+        self.assertEqual(blob, "9f7a5ddf144293fe3591989c784c8ec6d875cd07")
+        for path in (
+            "app/services/enterprise_b03_item_reconciliation.py",
+            "app/services/enterprise_g12_st_item_reconciliation.py",
+        ):
+            source = (ROOT / path).read_text(encoding="utf-8")
+            self.assertIn("EnterpriseTaxConsistencyEngine", source)
+            self.assertNotIn(
+                "from app.services.tax_consistency.tax_consistency_engine import TaxConsistencyEngine",
+                source,
+            )
+        b03 = (ROOT / "app/services/enterprise_b03_item_reconciliation.py").read_text(encoding="utf-8")
+        self.assertIn(
+            '"app.services.enterprise_tax_consistency.enterprise_tax_consistency_engine.EnterpriseTaxConsistencyEngine"',
+            b03,
+        )
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/tools/enterprise_recovery_test_gate_v3.py b/tools/enterprise_recovery_test_gate_v3.py
new file mode 100644
index 00000000..9cd1a3f1
--- /dev/null
+++ b/tools/enterprise_recovery_test_gate_v3.py
@@ -0,0 +1,267 @@
+"""Gate V3: extensão G1 privada, mantendo integralmente o gate V2.
+
+Exige a mesma baseline, os mesmos 25+6 casos, os 22 casos G1 originais,
+os 8 controlos da duplicação, hashes de produto, contrato e proveniência.
+Não reinterpreta uma das 13 falhas de baseline como GREEN global.
+"""
+from __future__ import annotations
+
+import argparse
+import ast
+import hashlib
+import importlib.util
+import json
+import platform
+import re
+import subprocess
+import sys
+from importlib.metadata import PackageNotFoundError, version
+from pathlib import Path
+
+_spec_v2 = importlib.util.spec_from_file_location(
+    "enterprise_recovery_test_gate_v2_frozen", Path(__file__).with_name("enterprise_recovery_test_gate.py")
+)
+assert _spec_v2 is not None and _spec_v2.loader is not None
+v2 = importlib.util.module_from_spec(_spec_v2)
+_spec_v2.loader.exec_module(v2)
+
+
+SCHEMA = "SOLVERIS_ENTERPRISE_RECOVERY_G1_SCOPE_V3"
+V2_MANIFEST_BLOB = "4eafb57b917a3910ef873d0b8ca30145a0940b09"
+ORIGINAL_G1_BLOB = "543f19b4b777ecaaa107d699dd13c002b378e8a2"
+ORIGINAL_TEST_BLOB = "45a2080a8adead467aa4b00275e3a33616b0966c"
+SHARED_G1_BLOB = "9f7a5ddf144293fe3591989c784c8ec6d875cd07"
+MANIFEST_FINGERPRINT = "dc195d2418cdf3e8c355575a4dfff80021738f952673287e3c59f8fd7ffb0ff2"
+
+# Todos estes caminhos foram individualmente ratificados por Miguel apenas
+# para o branch de recuperação. O manifesto V2 fica byte a byte intacto.
+V3_DELTA = frozenset({
+    "app/services/enterprise_tax_consistency/__init__.py",
+    "app/services/enterprise_tax_consistency/enterprise_tax_consistency_engine.py",
+    "docs/REGISTRO_CANONICO.json",
+    "tools/check_duplicacao.py",
+    "docs/DEBITO_TECNICO_G1_RECONCILIACAO_20261118.md",
+    "docs/B03_B04_STOP_DEPENDENCIA_G1_20261118.md",
+    "docs/B03_B04_BASELINE_ESCOPO_G1_V3_20261118.json",
+    "docs/B03_B04_PATCH_G1_PRIVADO_V3_20261118.patch",
+    "docs/B03_B04_EXECUCAO_G1_PRIVADO_V3_20261118.md",
+    "tests/enterprise_g1_contract_origin.py",
+    "tests/test_enterprise_g1_private_original_contract.py",
+    "tests/test_enterprise_g1_coexistence_gate.py",
+    "tools/enterprise_recovery_test_gate_v3.py",
+    "tests/test_enterprise_recovery_scope_v3_gate.py",
+})
+
+# Modificações a ficheiros V2 já autorizados, agora justificadas e pinadas
+# com novo hash. Nunca alterar os patches/documentos de V2 publicados.
+V3_OVERRIDES = frozenset({
+    "app/services/enterprise_b03_item_reconciliation.py",
+    "app/services/enterprise_g12_st_item_reconciliation.py",
+    "tests/test_enterprise_b01_atomic_rollback_contract.py",
+})
+PINNED = frozenset({
+    "app/services/enterprise_b03_item_reconciliation.py",
+    "app/services/enterprise_g12_st_item_reconciliation.py",
+    "app/services/enterprise_tax_consistency/__init__.py",
+    "app/services/enterprise_tax_consistency/enterprise_tax_consistency_engine.py",
+    "docs/REGISTRO_CANONICO.json",
+    "tools/check_duplicacao.py",
+    "docs/DEBITO_TECNICO_G1_RECONCILIACAO_20261118.md",
+    "tests/enterprise_g1_contract_origin.py",
+    "tests/test_enterprise_g1_private_original_contract.py",
+    "tests/test_enterprise_g1_coexistence_gate.py",
+    "tests/test_enterprise_b01_atomic_rollback_contract.py",
+})
+
+
+def _test_names(path: Path, class_name: str, prefix: str) -> set[str]:
+    tree = ast.parse(path.read_text(encoding="utf-8-sig"))
+    classes = [node for node in tree.body if isinstance(node, ast.ClassDef)
+               and node.name == class_name]
+    if len(classes) != 1:
+        raise v2.RecoveryGateError("G1_REQUIRED_TEST_CLASS_MISSING")
+    return {prefix + node.name for node in classes[0].body
+            if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef))
+            and node.name.startswith("test_")}
+
+
+def required_extra_nodes(repo: Path) -> set[str]:
+    original = _test_names(
+        repo / "tests/enterprise_g1_contract_origin.py", "TestG1", "",
+    )
+    coexistence = _test_names(
+        repo / "tests/test_enterprise_g1_coexistence_gate.py",
+        "TestEnterpriseG1CoexistenceGate", "",
+    )
+    if len(original) != 22 or len(coexistence) != 8:
+        raise v2.RecoveryGateError("G1_REQUIRED_TEST_COUNT_DIVERGENCE")
+    return {
+        "tests.test_enterprise_g1_private_original_contract."
+        "TestEnterpriseG1PrivateOriginalContract::" + name for name in original
+    } | {
+        "tests.test_enterprise_g1_coexistence_gate."
+        "TestEnterpriseG1CoexistenceGate::" + name for name in coexistence
+    }
+
+
+def verify_historical_source(repo: Path) -> None:
+    """Compara AST original e privado, ignorando SOMENTE docstring e nome da classe."""
+    command = ["git", "-C", str(repo), "show",
+               "ee100756:app/services/tax_consistency/tax_consistency_engine.py"]
+    result = subprocess.run(command, capture_output=True, text=True, check=False)
+    if result.returncode:
+        raise v2.RecoveryGateError("G1_HISTORICAL_SOURCE_UNAVAILABLE")
+    source = result.stdout
+    digest = hashlib.sha1(b"blob " + str(len(source.encode())).encode()
+                          + b"\0" + source.encode()).hexdigest()
+    if digest != ORIGINAL_G1_BLOB:
+        raise v2.RecoveryGateError("G1_HISTORICAL_BLOB_DIVERGED")
+    old = ast.parse(source)
+    new = ast.parse((repo / "app/services/enterprise_tax_consistency/"
+                     "enterprise_tax_consistency_engine.py").read_text(encoding="utf-8"))
+    for root in (old, new):
+        if not isinstance(root.body[0], ast.Expr) or not isinstance(root.body[0].value, ast.Constant):
+            raise v2.RecoveryGateError("G1_MODULE_DOCSTRING_MISSING")
+        root.body.pop(0)
+    original_classes = [n for n in old.body if isinstance(n, ast.ClassDef)]
+    private_classes = [n for n in new.body if isinstance(n, ast.ClassDef)]
+    if (len(original_classes) != 1 or len(private_classes) != 1
+            or original_classes[0].name != "TaxConsistencyEngine"
+            or private_classes[0].name != "EnterpriseTaxConsistencyEngine"):
+        raise v2.RecoveryGateError("G1_PRIVATE_CLASS_IDENTITY_DIVERGENCE")
+    private_classes[0].name = "TaxConsistencyEngine"
+    if ast.dump(old, include_attributes=False) != ast.dump(new, include_attributes=False):
+        raise v2.RecoveryGateError("G1_PRIVATE_IMPLEMENTATION_DIVERGED")
+
+
+def evaluate_v3(*, repo: Path, baseline: dict, candidate: dict, approved_v2: dict,
+                approved_v3: dict, changed_paths: set[str],
+                observed_blobs: dict[str, str], harness_hashes: dict[str, str]) -> dict:
+    if approved_v3.get("schema_version") != SCHEMA:
+        raise v2.RecoveryGateError("SCOPE_V3_SCHEMA_NOT_RATIFIED")
+    if (approved_v3.get("parent_v2_manifest_blob") != V2_MANIFEST_BLOB
+            or approved_v3.get("original_g1_blob") != ORIGINAL_G1_BLOB
+            or approved_v3.get("original_g1_test_blob") != ORIGINAL_TEST_BLOB
+            or approved_v3.get("main_shared_g1_blob") != SHARED_G1_BLOB
+            or approved_v3.get("GLOBAL_GREEN") is not False):
+        raise v2.RecoveryGateError("SCOPE_V3_ORIGIN_NOT_RATIFIED")
+    if (approved_v3.get("extra_paths") != sorted(V3_DELTA)
+            or approved_v3.get("modified_v2_paths") != sorted(V3_OVERRIDES)
+            or set(approved_v3.get("candidate_source_blobs", {})) != PINNED):
+        raise v2.RecoveryGateError("SCOPE_V3_UNRATIFIED_OR_EXPANDED")
+    if v2._canonical_digest(approved_v3) != MANIFEST_FINGERPRINT:
+        raise v2.RecoveryGateError("SCOPE_V3_MANIFEST_DIGEST_DIVERGED")
+    if changed_paths - (set(approved_v2["allowed_recovery_paths"]) | V3_DELTA):
+        raise v2.RecoveryGateError("SCOPE_V3_UNAPPROVED_PATH_CHANGED")
+    if not (V3_OVERRIDES | V3_DELTA).issubset(changed_paths):
+        raise v2.RecoveryGateError("SCOPE_V3_REQUIRED_PATH_MISSING")
+    if observed_blobs != approved_v3["candidate_source_blobs"]:
+        raise v2.RecoveryGateError("SCOPE_V3_SOURCE_BLOB_DIVERGENCE")
+    # A versão da main mantém-se fisicamente intocada.
+    if v2._git(repo, "hash-object", "app/services/tax_consistency/tax_consistency_engine.py") != SHARED_G1_BLOB:
+        raise v2.RecoveryGateError("SCOPE_V3_SHARED_G1_CHANGED")
+    verify_historical_source(repo)
+    if observed_blobs["tests/enterprise_g1_contract_origin.py"] != ORIGINAL_TEST_BLOB:
+        raise v2.RecoveryGateError("SCOPE_V3_ORIGINAL_22_TESTS_CHANGED")
+
+    # A proveniência dos 36 ficheiros é preservada; apenas os dois importadores
+    # G1 tiveram alteração explicitamente delimitada e versionada pela V3.
+    provenance = json.loads((repo / "docs/B03_B04_BLOB_PROVENIENCE_20261118.json").read_text(encoding="utf-8"))
+    entries = provenance.get("items", [])
+    if len(entries) != 36 or {e.get("path") for e in entries} != {
+            e.get("path") for e in entries if isinstance(e, dict)}:
+        raise v2.RecoveryGateError("SCOPE_V3_PROVENANCE_COUNT_INVALID")
+    for entry in entries:
+        path = entry["path"]
+        expected = (observed_blobs[path] if path in V3_OVERRIDES else entry["git_blob"])
+        if v2._git(repo, "hash-object", path) != expected:
+            raise v2.RecoveryGateError("SCOPE_V3_PROVENANCE_CHANGED:" + path)
+
+    checker = subprocess.run(
+        [sys.executable, str(repo / "tools/check_duplicacao.py"),
+         "--repo", str(repo), "--registro", "docs/REGISTRO_CANONICO.json"],
+        cwd=repo, capture_output=True, text=True, check=False,
+    )
+    if checker.returncode != 0:
+        raise v2.RecoveryGateError("SCOPE_V3_DUPLICATION_CHECK_FAILED")
+
+    extra = required_extra_nodes(repo)
+    if extra - set(candidate):
+        raise v2.RecoveryGateError("SCOPE_V3_G1_TESTS_MISSING")
+    if any(candidate[node][0] != "passed" for node in extra):
+        raise v2.RecoveryGateError("SCOPE_V3_G1_TESTS_RED")
+
+    # Passar apenas o delta adicional validado à exceção de caminhos V2 é
+    # equivalente a um filtro estrito, nunca a ignorar caminhos imprevistos:
+    # o conjunto integral foi verificado contra a allowlist V3 acima.
+    result = v2.evaluate(
+        baseline=baseline, candidate=candidate, approved=approved_v2,
+        contract_hashes=v2.PROTECTED,
+        changed_paths=changed_paths - V3_DELTA,
+        harness_hashes=harness_hashes,
+    )
+    result["schema_version"] = "SOLVERIS_ENTERPRISE_RECOVERY_GATE_V3"
+    result["scope_ratified"] = SCHEMA
+    result["enterprise_g1_original_tests_passed"] = 22
+    result["enterprise_g1_coexistence_tests_passed"] = 8
+    result["GLOBAL_GREEN"] = False
+    return result
+
+
+def run(args: argparse.Namespace) -> dict:
+    repo = args.repo.resolve()
+    if v2._git(repo, "branch", "--show-current") != v2.RECOVERY_BRANCH:
+        raise v2.RecoveryGateError("WRONG_RECOVERY_BRANCH")
+    if v2._git(repo, "rev-parse", v2.BASELINE_SHA) != v2.BASELINE_SHA:
+        raise v2.RecoveryGateError("BASELINE_COMMIT_UNAVAILABLE")
+    approved_v3 = json.loads(args.approved_manifest.read_text(encoding="utf-8"))
+    approved_v2_path = repo / "docs/B03_B04_BASELINE_ESCOPO_TRANSACIONAL_V2_20261118.json"
+    if v2._git(repo, "hash-object", str(approved_v2_path)) != V2_MANIFEST_BLOB:
+        raise v2.RecoveryGateError("SCOPE_V3_PARENT_V2_MANIFEST_CHANGED")
+    approved_v2 = json.loads(approved_v2_path.read_text(encoding="utf-8"))
+    try:
+        environment = {"python": platform.python_version(), "fastapi": version("fastapi"),
+                       "pydantic": version("pydantic")}
+    except PackageNotFoundError as exc:
+        raise v2.RecoveryGateError("TEST_DEPENDENCIES_NOT_INSTALLED") from exc
+    if approved_v2.get("environment") != environment:
+        raise v2.RecoveryGateError("TEST_ENVIRONMENT_DRIFT")
+    v2._verify_junit_digest(args.baseline_junit, approved_v2.get("baseline_junit_sha256"))
+    changed = set(v2._git(repo, "diff", "--name-only", v2.BASELINE_SHA).splitlines())
+    changed.update(v2._git(repo, "ls-files", "--others", "--exclude-standard").splitlines())
+    observed_blobs = {p: v2._git(repo, "hash-object", p) for p in PINNED}
+    harness = {p: v2._git(repo, "hash-object", p) for p in v2.BASELINE_HARNESS_OVERLAY}
+    return evaluate_v3(
+        repo=repo, baseline=v2.parse_junit(args.baseline_junit),
+        candidate=v2.parse_junit(args.candidate_junit),
+        approved_v2=approved_v2, approved_v3=approved_v3,
+        changed_paths=changed, observed_blobs=observed_blobs,
+        harness_hashes=harness,
+    )
+
+
+def main(argv=None) -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--repo", type=Path, default=Path("."))
+    parser.add_argument("--baseline-junit", type=Path, required=True)
+    parser.add_argument("--candidate-junit", type=Path, required=True)
+    parser.add_argument("--approved-manifest", type=Path, required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    args = parser.parse_args(argv)
+    try:
+        receipt = run(args)
+    except (v2.RecoveryGateError, OSError, json.JSONDecodeError, ValueError) as exc:
+        receipt = {
+            "schema_version": "SOLVERIS_ENTERPRISE_RECOVERY_GATE_V3",
+            "GLOBAL_GREEN": False,
+            "ENTERPRISE_RECOVERY_STATUS": "BLOCKED",
+            "reason": str(exc).split(":", 1)[0],
+        }
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    args.output.write_text(json.dumps(receipt, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
+    print(receipt["ENTERPRISE_RECOVERY_STATUS"])
+    return 0 if receipt["ENTERPRISE_RECOVERY_STATUS"] == "PASS_WITH_BASELINE_RED" else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
