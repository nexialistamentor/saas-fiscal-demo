+"""Controlos V3: G1 segregado, 22 contratos originais e anti-duplicação ativa."""
+from __future__ import annotations
+
+import copy
+import importlib.util
+import json
+from pathlib import Path
+import unittest
+from unittest.mock import patch
+
+
+ROOT = Path(__file__).resolve().parents[1]
+SPEC = importlib.util.spec_from_file_location(
+    "enterprise_recovery_gate_scope_v3",
+    ROOT / "tools/enterprise_recovery_test_gate_v3.py",
+)
+assert SPEC is not None and SPEC.loader is not None
+gate = importlib.util.module_from_spec(SPEC)
+SPEC.loader.exec_module(gate)
+
+PASS = ("passed", "", "")
+FAIL = ("failure", "", "")
+SKIP = ("skipped", "", "")
+
+
+class TestRecoveryGatePrivateG1ScopeV3(unittest.TestCase):
+    def setUp(self):
+        self.approved_v2 = json.loads(
+            (ROOT / "docs/B03_B04_BASELINE_ESCOPO_TRANSACIONAL_V2_20261118.json")
+            .read_text(encoding="utf-8")
+        )
+        self.approved_v3 = json.loads(
+            (ROOT / "docs/B03_B04_BASELINE_ESCOPO_G1_V3_20261118.json")
+            .read_text(encoding="utf-8")
+        )
+        self.baseline = {node: FAIL for node in gate.v2.EXPECTED_FAILURE_NODES}
+        self.baseline.update({f"tests.test_mock::pass_{i}": PASS for i in range(4074)})
+        self.baseline.update({f"tests.test_mock::skip_{i}": SKIP for i in range(15)})
+        self.candidate = dict(self.baseline)
+        self.candidate.update({node: PASS for node in gate.v2.REQUIRED_ENTERPRISE_NODES})
+        self.candidate.update({node: PASS for node in gate.v2.SCOPE_V2_REQUIRED_ATOMIC_NODES})
+        self.candidate.update({node: PASS for node in gate.required_extra_nodes(ROOT)})
+        self.paths = (set(self.approved_v2["allowed_recovery_paths"])
+                      - {"app/services/insights_engine.py"}) | gate.V3_DELTA
+        self.hashes = copy.deepcopy(self.approved_v3["candidate_source_blobs"])
+
+    def check(self):
+        return gate.evaluate_v3(
+            repo=ROOT, baseline=self.baseline, candidate=self.candidate,
+            approved_v2=self.approved_v2, approved_v3=self.approved_v3,
+            changed_paths=self.paths, observed_blobs=self.hashes,
+            harness_hashes=gate.v2.BASELINE_HARNESS_OVERLAY,
+        )
+
+    def test_v3_exige_22_mais_8_e_preserva_25_mais_6(self):
+        receipt = self.check()
+        self.assertIs(receipt["GLOBAL_GREEN"], False)
+        self.assertEqual(receipt["enterprise_wiring_tests_passed"], 25)
+        self.assertEqual(receipt["enterprise_atomic_tests_passed"], 6)
+        self.assertEqual(receipt["enterprise_g1_original_tests_passed"], 22)
+        self.assertEqual(receipt["enterprise_g1_coexistence_tests_passed"], 8)
+
+    def test_v3_sem_22_testes_originais_bloqueia(self):
+        node = next(n for n in self.candidate if "PrivateOriginalContract" in n)
+        self.candidate.pop(node)
+        with self.assertRaisesRegex(gate.v2.RecoveryGateError, "G1_TESTS_MISSING"):
+            self.check()
+
+    def test_v3_qualquer_contrato_g1_falho_bloqueia(self):
+        node = next(n for n in self.candidate if "PrivateOriginalContract" in n)
+        self.candidate[node] = FAIL
+        with self.assertRaisesRegex(gate.v2.RecoveryGateError, "G1_TESTS_RED"):
+            self.check()
+
+    def test_v3_sem_controlo_coexistencia_bloqueia(self):
+        node = next(n for n in self.candidate if "CoexistenceGate" in n)
+        self.candidate.pop(node)
+        with self.assertRaisesRegex(gate.v2.RecoveryGateError, "G1_TESTS_MISSING"):
+            self.check()
+
+    def test_v3_caminho_nao_ratificado_bloqueia(self):
+        self.paths.add("app/services/mei_publicacao.py")
+        with self.assertRaisesRegex(gate.v2.RecoveryGateError, "UNAPPROVED_PATH"):
+            self.check()
+
+    def test_v3_hash_produto_alterado_bloqueia(self):
+        self.hashes["app/services/enterprise_tax_consistency/enterprise_tax_consistency_engine.py"] = "0" * 40
+        with self.assertRaisesRegex(gate.v2.RecoveryGateError, "SOURCE_BLOB_DIVERGENCE"):
+            self.check()
+
+    def test_v3_manifesto_alterado_bloqueia(self):
+        self.approved_v3["original_g1_blob"] = "0" * 40
+        with self.assertRaisesRegex(gate.v2.RecoveryGateError, "ORIGIN_NOT_RATIFIED"):
+            self.check()
+
+    def test_v3_g13_com_nova_falha_bloqueia_pelo_gate_v2(self):
+        node = next(n for n in gate.v2.REQUIRED_ENTERPRISE_NODES if "test_01_circuito_real" in n)
+        self.candidate[node] = FAIL
+        with self.assertRaisesRegex(gate.v2.RecoveryGateError, "ENTERPRISE_WIRING_TEST_NOT_PASSED"):
+            self.check()
+
+    def test_v3_prova_confronto_original_nao_pode_ser_ignorada(self):
+        with patch.object(gate, "verify_historical_source", side_effect=gate.v2.RecoveryGateError("G1_AST_TAMPERED")):
+            with self.assertRaisesRegex(gate.v2.RecoveryGateError, "G1_AST_TAMPERED"):
+                self.check()
+
+
+if __name__ == "__main__":
+    unittest.main()
