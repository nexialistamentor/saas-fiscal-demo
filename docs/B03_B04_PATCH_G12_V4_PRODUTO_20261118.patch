+def _linha_sintetica_observavel(db, uf, ncm, reference_date, norm):
+    """Prova apenas um registo de ensaio B01 em SQLite :memory:.
+
+    Nao altera a autorizacao fiscal do resolvedor, nao e fonte de regra legal,
+    nem e invocada para bases reais ou registos sem marcador sintetico.
+    """
+    try:
+        bind = db.get_bind()
+        if (bind.dialect.name != 'sqlite'
+                or bind.url.database not in (None, ':memory:')
+                or type(norm) is not dict
+                or norm.get('fonte_legal') != 'ATO SINTETICO DE TESTE NAO OFICIAL'
+                or norm.get('nivel_confianca_fonte') != 'oficial'):
+            return None
+        from app.models import TabelaMVA
+        rows = (db.query(TabelaMVA)
+                .filter(TabelaMVA.estado == uf, TabelaMVA.ncm == ncm).all())
+        # Vigencia de inicio NULL tambem e elegivel para buscar_mva; nao
+        # podemos ignorar tal concorrente ao provar unicidade sintetica.
+        active = [r for r in rows
+                  if ((r.vigencia_inicio is None or
+                       (type(r.vigencia_inicio) is date
+                        and r.vigencia_inicio <= reference_date))
+                      and (r.vigencia_fim is None
+                           or (type(r.vigencia_fim) is date
+                               and r.vigencia_fim >= reference_date)))]
+        if len(active) != 1:
+            return None
+        row = active[0]
+        if (type(row.id) is not int or row.id <= 0
+                or type(row.vigencia_inicio) is not date
+                or row.importado_por != 'B01_SYNTHETIC_FIXTURE'
+                or row.fonte_legal != norm.get('fonte_legal')
+                or row.url_fonte != norm.get('url_fonte')
+                or row.nivel_confianca_fonte != norm.get('nivel_confianca_fonte')
+                or row.vigencia_inicio != norm.get('vigencia_inicio')
+                or row.vigencia_fim != norm.get('vigencia_fim')
+                or Decimal(str(row.mva)) != Decimal(str(norm.get('mva')))
+                or Decimal(str(row.aliquota_interna))
+                    != Decimal(str(norm.get('aliquota_interna')))):
+            return None
+        return row
+    except (AttributeError, KeyError, TypeError, ValueError, InvalidOperation):
+        return None
+
