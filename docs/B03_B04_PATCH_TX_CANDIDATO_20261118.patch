+++ b/tests/test_enterprise_b01_atomic_rollback_contract.py
@@ -0,0 +1,82 @@
+"""Contrato adicional (não substitui os 12 testes B01 originais).
+
+Integração apenas SQLite em memória, dados inteiramente sintéticos,
+nenhum endpoint público, migração, motor fiscal ou autorização de pagamento.
+"""
+
+from unittest import TestCase
+from unittest.mock import patch
+
+from app.models import Empresa, DocumentoFiscal, ItemFiscal, RelatorioAnalise, UsoPlataforma
+from app.services import registro_analise_service as registro
+from test_solveris_b01_circuit import TestEnterpriseB01SyntheticIntegration as _B01Fixture
+
+
+class TestEnterpriseB01AtomicRollback(TestCase):
+    def setUp(self):
+        self.fixture = _B01Fixture(
+            "test_01_circuito_real_writer_i2_g12_g14_adr020_c3_c7"
+        )
+        self.fixture.setUp()
+
+    def tearDown(self):
+        self.fixture.tearDown()
+
+    def assert_sem_escrita_parcial(self):
+        db = self.fixture.db
+        self.assertEqual(db.query(DocumentoFiscal).count(), 0)
+        self.assertEqual(db.query(ItemFiscal).count(), 0)
+        self.assertEqual(db.query(RelatorioAnalise).count(), 0)
+        self.assertEqual(db.query(UsoPlataforma).count(), 0)
+
+    def test_gate_g17_tardio_desfaz_documento_relatorio_e_uso(self):
+        with patch(
+            "app.services.enterprise_g17_publication_coverage_checkpoint."
+            "cotejar_cobertura_publicacao_g17",
+            side_effect=RuntimeError("TESTE_G17_TARDIO"),
+        ):
+            with self.assertRaisesRegex(RuntimeError, "TESTE_G17_TARDIO"):
+                self.fixture.run_circuit()
+        self.assert_sem_escrita_parcial()
+
+    def test_falha_contador_desfaz_documento_e_relatorio(self):
+        with patch.object(
+            registro, "incrementar_uso_analise", side_effect=RuntimeError("TESTE_USO")
+        ):
+            with self.assertRaisesRegex(RuntimeError, "TESTE_USO"):
+                self.fixture.run_circuit()
+        self.assert_sem_escrita_parcial()
+
+    def test_falha_na_confirmacao_final_desfaz_todas_as_escritas(self):
+        with patch.object(
+            self.fixture.db, "commit", side_effect=RuntimeError("FINAL_COMMIT_FALHOU")
+        ):
+            with self.assertRaisesRegex(RuntimeError, "FINAL_COMMIT_FALHOU"):
+                self.fixture.run_circuit()
+        self.assert_sem_escrita_parcial()
+
+    def test_escritor_optin_avulso_nao_pode_contornar_transacao(self):
+        with self.assertRaisesRegex(ValueError, "B01_OPTIN_SEM_TRANSACAO"):
+            registro.executar_e_registrar_analise_xml(
+                self.fixture.db, self.fixture.raw, 7, 41,
+                enterprise_opt_in=True,
+            )
+        self.assert_sem_escrita_parcial()
+
+    def test_sujeito_mei_nullable_recusado_antes_da_escrita(self):
+        empresa = self.fixture.db.get(Empresa, 41)
+        empresa.optante_mei = None
+        self.fixture.db.commit()
+        with self.assertRaisesRegex(ValueError, "B01_SUJEITO_NAO_AUTORIZADO"):
+            self.fixture.run_circuit()
+        self.assert_sem_escrita_parcial()
+
+    def test_operacao_enterprise_sintetica_nao_invoca_insights_com_commit_interno(self):
+        with patch(
+            "app.services.insights_engine.InsightEngine.gerar_insights_empresa",
+            side_effect=AssertionError("INSIGHTS_TRANSACTION_NOT_PROVEN"),
+        ):
+            resultado = self.fixture.run_circuit()
+        self.assertEqual(resultado["uso"], "INTERNO_NAO_PUBLICAVEL")
+        self.assertEqual(self.fixture.db.query(DocumentoFiscal).count(), 1)
+        self.assertEqual(self.fixture.db.query(RelatorioAnalise).count(), 1)
