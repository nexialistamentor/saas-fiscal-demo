@@ -0,0 +1,96 @@
+"""Controlos novos G12 V4; contrato B01 historico permanece imutavel.
+
+Somente SQLite :memory:, PR sintetico do teste original. O piloto PA e a
+autoridade fiscal nao se alteram; nenhuma fixture e convertida para PA.
+"""
+from datetime import date
+from unittest import TestCase
+
+from app.models import TabelaMVA
+from app.services.fiscal_utils import resolver_aliquota_e_mva
+import test_solveris_b01_circuit as original
+
+
+class TestEnterpriseG12SyntheticObservationV4(TestCase):
+    def setUp(self):
+        self.fixture = original.TestEnterpriseB01SyntheticIntegration(
+            "test_01_circuito_real_writer_i2_g12_g14_adr020_c3_c7"
+        )
+        self.fixture.setUp()
+
+    def tearDown(self):
+        self.fixture.tearDown()
+
+    def test_pr_continua_fora_da_autorizacao_fiscal_piloto_pa(self):
+        rule = resolver_aliquota_e_mva(
+            self.fixture.db, "PR", "12119090", data_referencia=date(2026, 4, 1)
+        )
+        self.assertIs(rule["calculo_autorizado"], False)
+        self.assertEqual(rule["motivo_bloqueio"], "fora_de_escopo_normativo_piloto")
+
+    def test_b01_pr_sintetico_produz_dossie_sem_autoridade(self):
+        r = self.fixture.run_circuit()
