@@ -0,0 +1,97 @@
+"""Controlos fail-closed do gate V4; nao executam produto ou bases reais."""
+from __future__ import annotations
+
+import importlib.util
+import json
+from pathlib import Path
+import unittest
+from unittest.mock import patch
+
+ROOT = Path(__file__).resolve().parents[1]
+SPEC = importlib.util.spec_from_file_location(
+    "enterprise_recovery_test_gate_v4_under_test",
+    ROOT / "tools/enterprise_recovery_test_gate_v4.py",
+)
+assert SPEC and SPEC.loader
+gate = importlib.util.module_from_spec(SPEC)
+SPEC.loader.exec_module(gate)
+
+
+class TestRecoveryGateV4(unittest.TestCase):
+    def setUp(self):
+        self.manifest = json.loads((ROOT / gate.MANIFEST).read_text(encoding="utf-8"))
+
+    def test_manifesto_v4_ratitificado_com_fingerprint_e_sem_green(self):
+        self.assertEqual(self.manifest["GLOBAL_GREEN"], False)
+        gate._manifest_valid(ROOT, self.manifest, require_commit=False)
+
+    def test_manifesto_v4_global_green_true_bloqueia(self):
+        altered = dict(self.manifest, GLOBAL_GREEN=True)
+        with self.assertRaisesRegex(
+            gate.v2.RecoveryGateError, "SCOPE_V4_UNRATIFIED_OR_EXPANDED"
+        ):
+            gate._manifest_valid(ROOT, altered, require_commit=False)
+
+    def test_manifesto_v4_alterado_fora_da_catraca_bloqueia(self):
+        altered = dict(self.manifest, ratification="SEM AUTORIDADE")
+        with self.assertRaisesRegex(
+            gate.v2.RecoveryGateError, "SCOPE_V4_MANIFEST_FINGERPRINT_DIVERGED"
+        ):
+            gate._manifest_valid(ROOT, altered, require_commit=False)
+
+    def test_manifesto_v4_nao_commitado_reprovado(self):
+        source_git = gate.v2._git
+
+        def git(root, *args):
+            if args == ("rev-parse", "HEAD:" + gate.MANIFEST):
+                return "0" * 40
+            return source_git(root, *args)
+
+        with patch.object(gate.v2, "_git", side_effect=git):
+            with self.assertRaisesRegex(
+                gate.v2.RecoveryGateError, "SCOPE_V4_MANIFEST_UNCOMMITTED"
+            ):
+                gate._manifest_valid(ROOT, self.manifest, require_commit=True)
+
+    def test_caminho_fora_do_escopo_bloqueia_antes_da_prova(self):
+        original = json.loads(
+            (ROOT / "docs/B03_B04_BASELINE_ESCOPO_G1_V3_20261118.json")
+            .read_text(encoding="utf-8")
+        )
+        with self.assertRaisesRegex(
+            gate.v2.RecoveryGateError, "SCOPE_V4_UNAPPROVED_PATH_CHANGED"
+        ):
+            gate.verify_v4_sources(
+                repo=ROOT, v3_manifest=original, v4=self.manifest,
+                changed_paths={"app/services/mei_perigoso.py"},
+                source_blobs=self.manifest["candidate_source_blobs"],
+            )
+
+    def test_um_novo_teste_red_impede_estado_de_recuperacao(self):
+        approved_v3 = json.loads(
+            (ROOT / "docs/B03_B04_BASELINE_ESCOPO_G1_V3_20261118.json")
+            .read_text(encoding="utf-8")
+        )
+        with patch.object(gate, "_manifest_valid"):
+            with patch.object(gate, "verify_v4_sources"):
+                with patch.object(gate, "_required_v4_nodes", return_value={"NOVO::RED"}):
+                    with self.assertRaisesRegex(
+                        gate.v2.RecoveryGateError, "SCOPE_V4_TESTS_RED"
+                    ):
+                        gate.evaluate_v4(
+                            repo=ROOT, baseline={}, candidate={"NOVO::RED": ("failure", "", "")},
+                            approved_v2={}, approved_v3=approved_v3,
+                            approved_v4=self.manifest, changed_paths=set(),
+                            source_blobs={}, harness_hashes={}, require_commit=False,
+                        )
+
+    def test_nodos_g1_historicos_e_v4_herdados_sem_omissao(self):
+        nodes = gate._required_v4_nodes(ROOT)
+        self.assertEqual(len(nodes), 22 + 8 + 8 + 6 + 7)
+        self.assertTrue(any("test_b01_pr_sintetico" in n for n in nodes))
+        self.assertTrue(any("test_gate_cli_v3_nao_aceita" in n for n in nodes))
+        self.assertTrue(any("test_snapshot_v3_e_real" in n for n in nodes))
+
+
+if __name__ == "__main__":
+    unittest.main()
