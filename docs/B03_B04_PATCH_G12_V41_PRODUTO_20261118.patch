+def _st_xml_parser_conciliado(group, parsed_item):
+    """Compara dois observadores do MESMO XML, sem qualquer fonte normativa.
+
+    Nao usa UF/NCM, ID, marcador de fixture, valor padrao ou autorizacao fiscal.
+    Exige pares monetarios de ICMS10 presentes nos dois leitores e identicos.
+    """
+    if type(parsed_item) is not dict:
+        return False
+    xml_base = _money(_text(group, 'n:vBCST'))
+    xml_st = _money(_text(group, 'n:vICMSST'))
+    parsed_base = _money(str(parsed_item.get('base_st')))
+    parsed_st = _money(str(parsed_item.get('valor_st')))
+    return (xml_base is not None and xml_base > 0
+            and xml_st is not None and xml_st >= 0
+            and parsed_base is not None and parsed_st is not None
+            and xml_base == parsed_base and xml_st == parsed_st)
+
