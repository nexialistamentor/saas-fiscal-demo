+"""Gate diferencial B03/B04: nunca converter RED de baseline em GREEN global.
+
+Uso (somente no branch isolado, após ratificação do manifesto de baseline):
+    python tools/enterprise_recovery_test_gate.py \
+      --baseline-junit CAMINHO --candidate-junit CAMINHO \
+      --approved-manifest docs/B03_B04_BASELINE_APROVADA.json \
+      --output docs/B03_B04_RESULTADO_GATE.json
+
+O XML bruto dos testes fica fora da documentação versionada. Este programa
+emite exclusivamente estado e identidades sanitizadas; não muda bases ou Git.
+"""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import platform
+import re
+import subprocess
+import sys
+import xml.etree.ElementTree as ET
+from collections import Counter
+from importlib.metadata import PackageNotFoundError, version
+from pathlib import Path
+
+
+BASELINE_SHA = "a6a2da6cbf07c7b9922f8571bf2e6016376304d5"
+RECOVERY_BRANCH = "recovery/enterprise-b00-b04-20261117"
+PROTECTED = {
+    "tests/test_mei_competencia_checkout_intent_http_contract_red.py":
+        "f8ef579db5052c9b80924bb7de5a0606d70b9413",
+    "tests/test_payments_checkout_offer_one_time_router_contract_red.py":
+        "015ecd0eba8f07268707f162dbe77c120c6789b2",
+    "tests/test_payments_tax_report_acquisition_http_create_contract_red.py":
+        "1f94eb43b9e02c3f5c2b73ac59b4b16918a4e2db",
+    "tests/test_payments_tax_report_checkout_intent_wiring_contract_red.py":
+        "5b7bc772c85704da3f491e3f1b658388246ed064",
+}
+BASELINE_HARNESS_OVERLAY = {
+    "tests/test_adr020_activation_postgresql.py":
+        "b7e551df23c3f2ec60bcf95d1a1c3c9be9a68d50",
+    "tests/test_agent_contract_architecture.py":
+        "0d24fd62d66277d0107af182e035059523d72dae",
+}
+
+# Os 13 IDs vieram da execução integral de main@a6a2da6c, exit 1.
+# Nunca aceitar um RED adicional por configuração automática do candidato.
+EXPECTED_FAILURE_NODES = frozenset({
+    "tests.test_mei_competencia_checkout_intent_http_contract_red::test_http_mei_intent_route_authentication_and_schema_red",
+    "tests.test_mei_normative_census::test_real_repository_call_site_scan_is_complete_and_has_no_structural_findings",
+    "tests.test_ops12_f2_gerar_relatorio_contract::test_f2_gerar_relatorio_sem_empresa_retorna_200",
+    "tests.test_ops12_f2_gerar_relatorio_contract::test_f2_gerar_relatorio_com_empresa_retorna_200",
+    "tests.test_payments_checkout_offer_campaign_dispatch_toctou_contract_red::test_payments_checkout_offer_campaign_dispatch_toctou_contract_red",
+    "tests.test_payments_checkout_offer_campaign_preference_expiry_contract_red::test_payments_checkout_offer_campaign_preference_expiry_contract_red",
+    "tests.test_payments_checkout_offer_one_time_router_contract_red::test_payments_checkout_offer_one_time_router_contract_red",
+    "tests.test_payments_checkout_offer_second_legitimate_payment_reconciliation_contract_red::test_payments_checkout_offer_second_legitimate_payment_reconciliation_contract_red",
+    "tests.test_payments_mercado_pago_main_wiring_contract_red::test_payments_mercado_pago_main_wiring_contract_red",
+    "tests.test_payments_multi_vertical_one_time_dispatch_contract_red::test_payments_multi_vertical_one_time_dispatch_contract_red",
+    "tests.test_payments_tax_report_acquisition_http_create_contract_red::test_tax_report_acquisition_http_create_route_and_authority_contract_red",
+    "tests.test_payments_tax_report_checkout_intent_wiring_contract_red::test_http_intent_endpoint_exists_authenticated_and_has_exact_input_red",
+    "tests.test_pipeline_xml_canonico::test_processar_xml_job_delega_para_eixo_canonico",
+})
+
+# Prova de religação, não apenas de presença dos blobs. Estes 25 casos
+# constam dos três contratos de origem c9a17fd1 (B03, B04 e B01).
+# Sem o circuito real B01 não é lícito aprovar a recuperação B03/B04.
+REQUIRED_ENTERPRISE_NODES = frozenset({
+    "tests.test_enterprise_b03_item_reconciliation.TestConfrontarDocumentoB03::test_sem_divergencia_quando_valores_batem",
+    "tests.test_enterprise_b03_item_reconciliation.TestConfrontarDocumentoB03::test_divergencia_quando_valor_xml_diverge_do_calculado",
+    "tests.test_enterprise_b03_item_reconciliation.TestConfrontarDocumentoB03::test_nao_avaliado_quando_falta_autoridade_normativa",
+    "tests.test_enterprise_b03_item_reconciliation.TestConfrontarDocumentoB03::test_falha_fechada_quando_campos_essenciais_ausentes",
+    "tests.test_enterprise_b03_item_reconciliation.TestConfrontarDocumentoB03::test_valor_produto_ausente_bloqueia_item_sem_crash",
+    "tests.test_enterprise_b03_item_reconciliation.TestConfrontarXmlB03::test_ponta_a_ponta_sem_divergencia",
+    "tests.test_enterprise_b03_item_reconciliation.TestConfrontarXmlB03::test_erro_de_parse_xml_nao_propaga_excecao",
+    "tests.test_enterprise_b04_icms_st_integral_bridge.TestProjetarDiagnosticoIntegralIcmsSt::test_sucesso_atualiza_so_as_tres_capacidades_relevantes",
+    "tests.test_enterprise_b04_icms_st_integral_bridge.TestProjetarDiagnosticoIntegralIcmsSt::test_falha_g13_marca_falha_motor_sem_crash",
+    "tests.test_enterprise_b04_icms_st_integral_bridge.TestProjetarDiagnosticoIntegralIcmsSt::test_sem_simulacao_nenhuma_vira_nao_apurado_nao_informativo",
+    "tests.test_enterprise_b04_icms_st_integral_bridge.TestProjetarDiagnosticoIntegralIcmsSt::test_g13_precomputado_e_usado_sem_recalcular",
