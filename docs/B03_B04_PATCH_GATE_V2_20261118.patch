+"""Controles mecânicos adicionais da ampliação B03/B04 aprovada por Miguel.
+
+Preserva os 20 controles originais V1 e não executa código de produto.
+"""
+
+import importlib.util
+import json
+import unittest
+from pathlib import Path
+
+
+ROOT = Path(__file__).resolve().parents[1]
+SPEC = importlib.util.spec_from_file_location(
+    "enterprise_recovery_gate_scope_v2",
+    ROOT / "tools" / "enterprise_recovery_test_gate.py",
+)
+assert SPEC and SPEC.loader
+gate = importlib.util.module_from_spec(SPEC)
+SPEC.loader.exec_module(gate)
+
+PASS = ("passed", "", "")
+FAIL = ("failure", "", "")
+SKIP = ("skipped", "", "")
+
+
+class TestRecoveryGateTransactionScopeV2(unittest.TestCase):
+    def setUp(self):
+        self.approved = json.loads(
+            (ROOT / "docs/B03_B04_BASELINE_ESCOPO_TRANSACIONAL_V2_20261118.json")
+            .read_text(encoding="utf-8")
+        )
+        self.baseline = {node: FAIL for node in gate.EXPECTED_FAILURE_NODES}
+        self.baseline.update({f"tests.test_mock::pass_{i}": PASS for i in range(4074)})
+        self.baseline.update({f"tests.test_mock::skip_{i}": SKIP for i in range(15)})
+        self.candidate = dict(self.baseline)
+        self.candidate.update({node: PASS for node in gate.REQUIRED_ENTERPRISE_NODES})
+        self.candidate.update({node: PASS for node in gate.SCOPE_V2_REQUIRED_ATOMIC_NODES})
+
+    def evaluate(self):
+        return gate.evaluate(
+            baseline=self.baseline,
+            candidate=self.candidate,
+            approved=self.approved,
+            contract_hashes=gate.PROTECTED,
+            harness_hashes=gate.BASELINE_HARNESS_OVERLAY,
+            changed_paths=(
+                set(self.approved["allowed_recovery_paths"])
+                - {"app/services/insights_engine.py"}
+            ),
+        )
+
+    def test_v2_ratifcado_exige_25_mais_6_e_nao_declara_green_global(self):
+        result = self.evaluate()
+        self.assertIs(result["GLOBAL_GREEN"], False)
+        self.assertEqual(result["enterprise_wiring_tests_passed"], 25)
+        self.assertEqual(result["enterprise_atomic_tests_passed"], 6)
+        self.assertEqual(result["ENTERPRISE_RECOVERY_STATUS"], "PASS_WITH_BASELINE_RED")
+
+    def test_caso_atomico_ausente_bloqueia(self):
+        self.candidate.pop(next(iter(gate.SCOPE_V2_REQUIRED_ATOMIC_NODES)))
+        with self.assertRaisesRegex(gate.RecoveryGateError, "ATOMIC_TESTS_MISSING"):
+            self.evaluate()
+
+    def test_caso_atomico_falho_bloqueia(self):
+        self.candidate[next(iter(gate.SCOPE_V2_REQUIRED_ATOMIC_NODES))] = FAIL
+        with self.assertRaisesRegex(gate.RecoveryGateError, "ATOMIC_TEST_NOT_PASSED"):
+            self.evaluate()
+
+    def test_caminho_adicional_ilegitimo_bloqueia(self):
+        self.approved["allowed_recovery_paths"].append("app/services/memoria_estrategica_service.py")
+        with self.assertRaisesRegex(gate.RecoveryGateError, "SCOPE_V2_UNRATIFIED_OR_EXPANDED"):
+            self.evaluate()
+
+    def test_retirar_ficheiro_da_extensao_bloqueia(self):
+        self.approved["allowed_recovery_paths"].remove("app/xml_service.py")
+        with self.assertRaisesRegex(gate.RecoveryGateError, "SCOPE_V2_UNRATIFIED_OR_EXPANDED"):
+            self.evaluate()
+
+    def test_patch_nao_ratificado_bloqueia(self):
+        self.approved["candidate_patch_git_blob"] = "0" * 40
+        with self.assertRaisesRegex(gate.RecoveryGateError, "SCOPE_V2_UNRATIFIED_OR_EXPANDED"):
+            self.evaluate()
+
+    def test_codigo_candidato_diferente_do_patch_bloqueia(self):
+        self.approved["candidate_source_blobs"]["app/xml_service.py"] = "0" * 40
+        with self.assertRaisesRegex(gate.RecoveryGateError, "SCOPE_V2_UNRATIFIED_OR_EXPANDED"):
+            self.evaluate()
+
+    def test_insights_com_commit_nao_integrado_bloqueia(self):
+        with self.assertRaisesRegex(gate.RecoveryGateError, "INSIGHTS_COMMIT_NOT_PROVEN_ATOMIC"):
+            gate.evaluate(
+                baseline=self.baseline,
+                candidate=self.candidate,
+                approved=self.approved,
+                contract_hashes=gate.PROTECTED,
+                changed_paths=set(self.approved["allowed_recovery_paths"]),
+            )
+
+    def test_schema_desconhecido_bloqueia(self):
+        self.approved["schema_version"] = "v3_inesperada"
+        with self.assertRaisesRegex(gate.RecoveryGateError, "UNKNOWN_RECOVERY_SCOPE_SCHEMA"):
+            self.evaluate()
+
+
+if __name__ == "__main__":
+    unittest.main()
