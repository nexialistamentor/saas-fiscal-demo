+class RecoveryGateError(ValueError):
+    pass
+
+
+def _git(repo: Path, *args: str) -> str:
+    result = subprocess.run(
+        ["git", "-C", str(repo), *args],
+        capture_output=True, text=True, check=False,
+    )
+    if result.returncode:
+        raise RecoveryGateError(f"GIT_QUERY_FAILED:{args[0]}")
+    return result.stdout.strip()
+
+
+def _identity(element: ET.Element) -> str:
+    classname, name = element.get("classname"), element.get("name")
+    if not classname or not name:
+        raise RecoveryGateError("JUNIT_MISSING_TEST_IDENTITY")
+    return f"{classname}::{name}"
+
+
+def parse_junit(path: Path) -> dict[str, tuple[str, str, str]]:
+    try:
+        root = ET.parse(path).getroot()
+    except (ET.ParseError, OSError) as exc:
+        raise RecoveryGateError("JUNIT_MISSING_OR_INVALID") from exc
+    suites = [root] if root.tag == "testsuite" else list(root.findall("testsuite"))
+    if not suites:
+        raise RecoveryGateError("JUNIT_NO_SUITES")
+    results: dict[str, tuple[str, str, str]] = {}
+    declared = 0
+    for suite in suites:
+        try:
+            declared += int(suite.attrib["tests"])
+        except (KeyError, ValueError) as exc:
+            raise RecoveryGateError("JUNIT_SUITE_COUNT_ABSENT") from exc
+        for case in suite.findall("testcase"):
+            node = _identity(case)
+            if node in results:
+                raise RecoveryGateError("JUNIT_DUPLICATED_TEST_IDENTITY")
+            outcome = [(kind, case.find(kind)) for kind in ("failure", "error", "skipped")]
+            observed = [(kind, element) for kind, element in outcome if element is not None]
+            if len(observed) > 1:
+                raise RecoveryGateError("JUNIT_MULTIPLE_OUTCOMES")
+            if observed:
+                kind, element = observed[0]
+                assert element is not None
+                results[node] = (kind, element.get("type", ""), element.get("message", ""))
+            else:
+                results[node] = ("passed", "", "")
+    if declared != len(results):
+        raise RecoveryGateError("JUNIT_INCOMPLETE_OR_DUPLICATED")
+    return results
+
+
+def _canonical_digest(value: object) -> str:
+    serialized = json.dumps(value, sort_keys=True, separators=(",", ":"), ensure_ascii=False)
+    return hashlib.sha256(serialized.encode("utf-8")).hexdigest()
+
+
+def _verify_junit_digest(path: Path, approved_digest: object) -> None:
+    if not isinstance(approved_digest, str) or not re.fullmatch(r"[0-9a-f]{64}", approved_digest):
+        raise RecoveryGateError("BASELINE_JUNIT_DIGEST_NOT_RATIFIED")
+    try:
+        with path.open("rb") as stream:
+            actual = hashlib.file_digest(stream, "sha256").hexdigest()
+    except OSError as exc:
+        raise RecoveryGateError("BASELINE_JUNIT_MISSING") from exc
+    if actual != approved_digest:
+        raise RecoveryGateError("BASELINE_JUNIT_DIGEST_DIVERGENCE")
+
+
+def _baseline_failures(results: dict[str, tuple[str, str, str]]) -> dict[str, dict[str, str]]:
+    return {
+        node: {
+            "outcome": outcome, "type": kind,
+            "message_sha256": hashlib.sha256(message.encode("utf-8")).hexdigest(),
+        }
+        for node, (outcome, kind, message) in sorted(results.items())
+        if outcome in ("failure", "error")
+    }
+
+
+def _unsafe_mei_path(path: str) -> bool:
+    normalized = path.lower().replace("\\", "/")
+    components = normalized.split("/")
+    return any(
+        part == "mei" or part.startswith("mei_") or part.endswith("_mei")
+        or part.startswith("test_mei_")
+        for part in components
+    )
+
