+"""Controlos negativos do gate diferencial estrito B03/B04."""
+
+from __future__ import annotations
+
+import hashlib
+import importlib.util
+import json
+import tempfile
+import unittest
+from collections import Counter
+from pathlib import Path
+
+
+ROOT = Path(__file__).resolve().parents[1]
+SPEC = importlib.util.spec_from_file_location(
+    "enterprise_recovery_test_gate",
+    ROOT / "tools" / "enterprise_recovery_test_gate.py",
+)
+assert SPEC and SPEC.loader
+gate = importlib.util.module_from_spec(SPEC)
+SPEC.loader.exec_module(gate)
+
+TEST_MEI = (
+    "tests.test_mei_competencia_checkout_intent_http_contract_red"
+    "::test_http_mei_intent_route_authentication_and_schema_red"
+)
+TEST_PASS = "tests.test_enterprise_b03::test_gate"
+TEST_SKIP = "tests.test_other::test_skip"
+FAIL = ("failure", "AttributeError", "ModelField missing type_")
+PASSED = ("passed", "", "")
+SKIPPED = ("skipped", "", "reason")
+
+
+def _approved(baseline, *, paths=()):
+    recorded = gate._baseline_failures(baseline)
+    counts = Counter(outcome for outcome, _, _ in baseline.values())
+    environment = {
+        "python": "3.12.0", "fastapi": "0.135.1", "pydantic": "2.12.5",
+    }
+    return {
+        "baseline_sha": gate.BASELINE_SHA,
+        "baseline_exit_code": 1,
+        "scope": "ISOLATED_B03_B04_RECOVERY_ONLY",
+        "expected_baseline_tests": len(baseline),
+        "baseline_counts": {
+            "passed": counts["passed"], "failure": counts["failure"],
+            "error": counts["error"], "skipped": counts["skipped"],
+        },
+        "GLOBAL_GREEN": False,
+        "protected_contracts": gate.PROTECTED,
+        "test_harness_overlay": gate.BASELINE_HARNESS_OVERLAY,
+        "baseline_junit_sha256": "a" * 64,
+        "accepted_failure_ids": sorted(recorded),
+        "environment": environment,
+        "allowed_recovery_paths": list(paths),
+        "accepted_failure_fingerprint": gate._canonical_digest({
+            "baseline_sha": gate.BASELINE_SHA,
+            "baseline_junit_sha256": "a" * 64,
+            "accepted_failure_ids": sorted(recorded),
+            "protected_contracts": gate.PROTECTED,
+            "test_harness_overlay": gate.BASELINE_HARNESS_OVERLAY,
+            "environment": environment,
+        }),
+    }
+
+
+class RecoveryGateContractTests(unittest.TestCase):
+    def setUp(self):
+        self.baseline = {node: FAIL for node in gate.EXPECTED_FAILURE_NODES}
+        self.baseline.update({TEST_PASS: PASSED, TEST_SKIP: SKIPPED})
+        self.candidate = dict(self.baseline)
+        self.candidate.update({node: PASSED for node in gate.REQUIRED_ENTERPRISE_NODES})
+        self.approved = _approved(self.baseline, paths=("app/services/enterprise_b04.py",))
+
+    def _evaluate(self, *, changes=()):
+        return gate.evaluate(
+            baseline=self.baseline,
+            candidate=self.candidate,
+            approved=self.approved,
+            contract_hashes=gate.PROTECTED,
+            changed_paths=set(changes),
+        )
+
+    def test_pass_still_has_explicit_global_red(self):
+        self.candidate["tests.test_enterprise_b04::test_new"] = PASSED
+        result = self._evaluate(changes=("app/services/enterprise_b04.py",))
+        self.assertIs(result["GLOBAL_GREEN"], False)
+        self.assertEqual(result["ENTERPRISE_RECOVERY_STATUS"], "PASS_WITH_BASELINE_RED")
+        self.assertEqual(result["new_tests_passed"], len(gate.REQUIRED_ENTERPRISE_NODES) + 1)
+        self.assertEqual(result["enterprise_wiring_tests_passed"], 25)
+
+    def test_missing_b01_wiring_test_fails_closed(self):
+        node = next(n for n in gate.REQUIRED_ENTERPRISE_NODES if n.startswith("tests.test_solveris_b01_circuit."))
+        self.candidate.pop(node)
+        with self.assertRaisesRegex(gate.RecoveryGateError, "ENTERPRISE_WIRING_TESTS_MISSING"):
+            self._evaluate()
+
+    def test_b01_wiring_test_failed_blocks_recovery(self):
+        node = next(n for n in gate.REQUIRED_ENTERPRISE_NODES if n.startswith("tests.test_solveris_b01_circuit."))
+        self.candidate[node] = FAIL
+        with self.assertRaisesRegex(gate.RecoveryGateError, "ENTERPRISE_WIRING_TEST_NOT_PASSED"):
+            self._evaluate()
+
+    def test_missing_baseline_test_fails_closed(self):
+        self.candidate.pop(TEST_PASS)
+        with self.assertRaisesRegex(gate.RecoveryGateError, "BASELINE_TESTS_NOT_EXECUTED"):
+            self._evaluate()
+
+    def test_prior_pass_becomes_failure_fails_closed(self):
+        self.candidate[TEST_PASS] = FAIL
+        with self.assertRaisesRegex(gate.RecoveryGateError, "NEW_FAILURE_OR_WEAKENED_TEST"):
+            self._evaluate()
+
+    def test_new_skipped_test_fails_closed(self):
+        self.candidate["tests.test_enterprise_b04::new"] = SKIPPED
+        with self.assertRaisesRegex(gate.RecoveryGateError, "NEW_FAILURE_OR_WEAKENED_TEST"):
+            self._evaluate()
+
+    def test_baseline_red_becomes_skipped_fails_closed(self):
+        self.candidate[TEST_MEI] = SKIPPED
+        with self.assertRaisesRegex(gate.RecoveryGateError, "NEW_FAILURE_OR_WEAKENED_TEST"):
+            self._evaluate()
+
+    def test_baseline_red_changed_cause_fails_closed(self):
+        self.candidate[TEST_MEI] = ("failure", "AssertionError", "different")
+        with self.assertRaisesRegex(gate.RecoveryGateError, "NEW_FAILURE_OR_WEAKENED_TEST"):
+            self._evaluate()
+
+    def test_protected_hash_divergence_fails_closed(self):
+        with self.assertRaisesRegex(gate.RecoveryGateError, "PROTECTED_CONTRACT_HASH_DIVERGENCE"):
+            gate.evaluate(
+                baseline=self.baseline, candidate=self.candidate,
+                approved=self.approved, contract_hashes={}, changed_paths=set(),
+            )
+
+    def test_test_harness_hash_divergence_fails_closed(self):
+        with self.assertRaisesRegex(gate.RecoveryGateError, "TEST_HARNESS_OVERLAY_DIVERGED"):
+            gate.evaluate(
+                baseline=self.baseline, candidate=self.candidate,
+                approved=self.approved, contract_hashes=gate.PROTECTED,
+                harness_hashes={}, changed_paths=set(),
+            )
+
+    def test_unapproved_baseline_failure_fails_closed(self):
+        self.approved["accepted_failure_ids"] = []
+        with self.assertRaisesRegex(gate.RecoveryGateError, "BASELINE_FAILURES_NOT_EXACTLY_RATIFIED"):
+            self._evaluate()
+
+    def test_forged_global_green_fails_closed(self):
+        self.approved["GLOBAL_GREEN"] = True
+        with self.assertRaisesRegex(gate.RecoveryGateError, "GLOBAL_GREEN_FALSE_REQUIRED"):
+            self._evaluate()
+
+    def test_mei_changed_fails_closed(self):
+        self.approved["allowed_recovery_paths"].append("tests/test_mei_unrelated.py")
+        with self.assertRaisesRegex(gate.RecoveryGateError, "MEI_SOURCE_OR_TEST_CHANGED"):
+            self._evaluate(changes=("tests/test_mei_unrelated.py",))
+
+    def test_unratified_fourteenth_baseline_failure_fails_closed(self):
+        self.baseline[TEST_PASS] = FAIL
+        self.approved = _approved(self.baseline)
+        with self.assertRaisesRegex(gate.RecoveryGateError, "BASELINE_FAILURE_NODE_SET_DIVERGED"):
+            self._evaluate()
+
+    def test_missing_one_of_thirteen_fails_closed(self):
+        self.baseline[TEST_MEI] = PASSED
+        self.approved = _approved(self.baseline)
+        with self.assertRaisesRegex(gate.RecoveryGateError, "BASELINE_FAILURE_NODE_SET_DIVERGED"):
+            self._evaluate()
+
+    def test_unapproved_path_fails_closed(self):
+        with self.assertRaisesRegex(gate.RecoveryGateError, "UNAPPROVED_RECOVERY_FILE_CHANGED"):
+            self._evaluate(changes=("app/services/enterprise_unreviewed.py",))
+
+    def test_junit_counts_and_failure_signatures(self):
+        with tempfile.TemporaryDirectory() as directory:
+            path = Path(directory) / "junit.xml"
+            path.write_text(
+                '<testsuites><testsuite tests="2" failures="1" errors="0" skipped="0">'
+                '<testcase classname="tests.test_enterprise_b03" name="test_gate" />'
+                '<testcase classname="tests.test_mei_competencia_checkout_intent_http_contract_red" '
+                'name="test_http_mei_intent_route_authentication_and_schema_red">'
+                '<failure type="AttributeError" message="ModelField missing type_" />'
+                '</testcase></testsuite></testsuites>',
+                encoding="utf-8",
+            )
+            parsed = gate.parse_junit(path)
+            self.assertEqual(parsed[TEST_MEI], FAIL)
+            expected_digest = hashlib.sha256(FAIL[2].encode()).hexdigest()
+            self.assertEqual(
+                gate._baseline_failures(parsed)[TEST_MEI]["message_sha256"],
+                expected_digest,
+            )
+
+    def test_truncated_junit_fails_closed(self):
+        with tempfile.TemporaryDirectory() as directory:
+            path = Path(directory) / "truncated.xml"
+            path.write_text(
+                '<testsuites><testsuite tests="2"><testcase classname="x" name="a" />'
+                '</testsuite></testsuites>', encoding="utf-8",
+            )
+            with self.assertRaisesRegex(gate.RecoveryGateError, "JUNIT_INCOMPLETE"):
+                gate.parse_junit(path)
+
+    def test_baseline_junit_digest_is_immutable(self):
+        with tempfile.TemporaryDirectory() as directory:
+            path = Path(directory) / "report.xml"
+            path.write_text("<testsuites />", encoding="utf-8")
+            digest = hashlib.sha256(path.read_bytes()).hexdigest()
+            gate._verify_junit_digest(path, digest)
+            with self.assertRaisesRegex(gate.RecoveryGateError, "JUNIT_DIGEST_DIVERGENCE"):
+                gate._verify_junit_digest(path, "a" * 64)
+
+    def test_ratified_full_baseline_manifest_is_consistent(self):
+        manifest_path = ROOT / "docs/B03_B04_BASELINE_RATIFICADA_20261118.json"
+        approved = json.loads(manifest_path.read_text(encoding="utf-8"))
+        baseline = {node: ("failure", "", "") for node in gate.EXPECTED_FAILURE_NODES}
+        baseline.update({f"tests.test_dummy::passed_{i}": PASSED for i in range(4074)})
+        baseline.update({f"tests.test_dummy::skipped_{i}": SKIPPED for i in range(15)})
+        result = gate.evaluate(
+            baseline=baseline,
+            candidate={**baseline, **{node: PASSED for node in gate.REQUIRED_ENTERPRISE_NODES}},
+            approved=approved,
+            contract_hashes=gate.PROTECTED,
+            harness_hashes=gate.BASELINE_HARNESS_OVERLAY,
+            changed_paths=set(approved["allowed_recovery_paths"]),
+        )
+        self.assertIs(result["GLOBAL_GREEN"], False)
+        self.assertEqual(result["baseline_tests"], 4102)
+        self.assertEqual(result["enterprise_wiring_tests_passed"], 25)
+        self.assertEqual(result["remaining_baseline_failures"], sorted(gate.EXPECTED_FAILURE_NODES))
+
+
+if __name__ == "__main__":
+    unittest.main()
