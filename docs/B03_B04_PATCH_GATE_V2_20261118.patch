+def evaluate(
+    *, baseline: dict[str, tuple[str, str, str]],
+    candidate: dict[str, tuple[str, str, str]], approved: dict,
+    contract_hashes: dict[str, str], changed_paths: set[str],
+    harness_hashes: dict[str, str] | None = None,
+) -> dict:
+    if approved.get("baseline_sha") != BASELINE_SHA:
+        raise RecoveryGateError("BASELINE_SHA_NOT_RATIFIED")
+    if approved.get("baseline_exit_code") != 1:
+        raise RecoveryGateError("BASELINE_RED_EXIT_NOT_RECORDED")
+    if approved.get("scope") != "ISOLATED_B03_B04_RECOVERY_ONLY":
+        raise RecoveryGateError("RECOVERY_SCOPE_NOT_RATIFIED")
+    expected = approved.get("expected_baseline_tests")
+    if type(expected) is not int or expected < 1 or len(baseline) != expected:
+        raise RecoveryGateError("BASELINE_COLLECTION_INCOMPLETE")
+    baseline_counts = Counter(outcome for outcome, _, _ in baseline.values())
+    expected_counts = {
+        "passed": baseline_counts["passed"],
+        "failure": baseline_counts["failure"],
+        "error": baseline_counts["error"],
+        "skipped": baseline_counts["skipped"],
+    }
+    if approved.get("baseline_counts") != expected_counts:
+        raise RecoveryGateError("BASELINE_COUNTS_NOT_RATIFIED")
+    if approved.get("GLOBAL_GREEN") is not False:
+        raise RecoveryGateError("GLOBAL_GREEN_FALSE_REQUIRED")
+    if approved.get("protected_contracts") != PROTECTED or contract_hashes != PROTECTED:
+        raise RecoveryGateError("PROTECTED_CONTRACT_HASH_DIVERGENCE")
+    if approved.get("test_harness_overlay") != BASELINE_HARNESS_OVERLAY:
+        raise RecoveryGateError("TEST_HARNESS_NOT_RATIFIED")
+    if harness_hashes is not None and harness_hashes != BASELINE_HARNESS_OVERLAY:
+        raise RecoveryGateError("TEST_HARNESS_OVERLAY_DIVERGED")
+    environment = approved.get("environment")
+    if not isinstance(environment, dict) or not all(
+        isinstance(environment.get(key), str) and environment[key]
+        for key in ("python", "fastapi", "pydantic")
+    ):
+        raise RecoveryGateError("BASELINE_ENVIRONMENT_UNBOUND")
+    recorded = _baseline_failures(baseline)
+    if approved.get("accepted_failure_ids") != sorted(recorded):
+        raise RecoveryGateError("BASELINE_FAILURES_NOT_EXACTLY_RATIFIED")
+    if set(recorded) != EXPECTED_FAILURE_NODES:
+        raise RecoveryGateError("BASELINE_FAILURE_NODE_SET_DIVERGED")
+    if any(_unsafe_mei_path(path) for path in changed_paths):
+        raise RecoveryGateError("MEI_SOURCE_OR_TEST_CHANGED")
+    allowed_paths = approved.get("allowed_recovery_paths")
+    if not isinstance(allowed_paths, list) or any(type(path) is not str for path in allowed_paths):
+        raise RecoveryGateError("CHANGED_PATHS_NOT_RATIFIED")
+    scope_schema = approved.get("schema_version")
+    if scope_schema not in (None, "SOLVERIS_ENTERPRISE_RECOVERY_BASELINE_V1", SCOPE_V2_SCHEMA):
+        raise RecoveryGateError("UNKNOWN_RECOVERY_SCOPE_SCHEMA")
+    transactional_v2 = scope_schema == SCOPE_V2_SCHEMA
+    if transactional_v2:
+        allowed_set = set(allowed_paths)
+        if (
+            len(allowed_set) != len(allowed_paths)
+            or not SCOPE_V2_DELTA.issubset(allowed_set)
+            or _canonical_digest(sorted(allowed_set - SCOPE_V2_DELTA))
+                != SCOPE_V1_PATHS_DIGEST
+            or approved.get("parent_manifest_git_blob") != SCOPE_V2_PARENT_BLOB
+            or approved.get("candidate_patch_git_blob") != SCOPE_V2_PATCH_BLOB
+            or approved.get("candidate_source_blobs") != SCOPE_V2_CANDIDATE_SOURCE_BLOBS
+            or set(approved.get("required_atomic_nodes", ()))
+                != SCOPE_V2_REQUIRED_ATOMIC_NODES
+        ):
+            raise RecoveryGateError("SCOPE_V2_UNRATIFIED_OR_EXPANDED")
+    if changed_paths - set(allowed_paths):
+        raise RecoveryGateError("UNAPPROVED_RECOVERY_FILE_CHANGED")
+    if transactional_v2 and "app/services/insights_engine.py" in changed_paths:
+        raise RecoveryGateError("INSIGHTS_COMMIT_NOT_PROVEN_ATOMIC")
+    missing = set(baseline) - set(candidate)
+    if missing:
+        raise RecoveryGateError("BASELINE_TESTS_NOT_EXECUTED")
+    missing_enterprise = REQUIRED_ENTERPRISE_NODES - set(candidate)
+    if missing_enterprise:
+        raise RecoveryGateError("ENTERPRISE_WIRING_TESTS_MISSING")
+    if any(candidate[node][0] != "passed" for node in REQUIRED_ENTERPRISE_NODES):
+        raise RecoveryGateError("ENTERPRISE_WIRING_TEST_NOT_PASSED")
+    if transactional_v2:
+        if SCOPE_V2_REQUIRED_ATOMIC_NODES - set(candidate):
+            raise RecoveryGateError("ENTERPRISE_ATOMIC_TESTS_MISSING")
+        if any(candidate[node][0] != "passed" for node in SCOPE_V2_REQUIRED_ATOMIC_NODES):
+            raise RecoveryGateError("ENTERPRISE_ATOMIC_TEST_NOT_PASSED")
+
+    violations = []
+    for node, prior in sorted(baseline.items()):
+        current = candidate[node]
+        if prior[0] == "passed" and current[0] != "passed":
+            violations.append(node)
+        elif prior[0] == "skipped" and current[0] not in ("skipped", "passed"):
+            violations.append(node)
+        elif prior[0] in ("failure", "error") and current[0] not in ("passed", "failure", "error"):
+            violations.append(node)
+        elif prior[0] in ("failure", "error") and current[0] != "passed" and current != prior:
+            violations.append(node)
+    for node in sorted(set(candidate) - set(baseline)):
+        if candidate[node][0] != "passed":
+            violations.append(node)
+    if violations:
+        raise RecoveryGateError("NEW_FAILURE_OR_WEAKENED_TEST:" + ",".join(violations[:8]))
+
+    fingerprint = _canonical_digest({
+        "baseline_sha": BASELINE_SHA,
+        "baseline_junit_sha256": approved.get("baseline_junit_sha256"),
+        "accepted_failure_ids": sorted(recorded),
+        "protected_contracts": PROTECTED,
+        "test_harness_overlay": BASELINE_HARNESS_OVERLAY,
+        "environment": environment,
+    })
+    if approved.get("accepted_failure_fingerprint") != fingerprint:
+        raise RecoveryGateError("BASELINE_FINGERPRINT_UNRATIFIED")
+
+    remaining_failures = _baseline_failures(candidate)
+    receipt = {
+        "schema_version": "SOLVERIS_ENTERPRISE_RECOVERY_GATE_V1",
+        "GLOBAL_GREEN": False,
+        "ENTERPRISE_RECOVERY_STATUS": "PASS_WITH_BASELINE_RED",
+        "MEI_BASELINE_FAILURE_ACCEPTED_FINGERPRINT": fingerprint,
+        "baseline_sha": BASELINE_SHA,
+        "baseline_tests": len(baseline),
+        "candidate_tests": len(candidate),
+        "new_tests_passed": len(candidate) - len(baseline),
+        "enterprise_wiring_tests_passed": len(REQUIRED_ENTERPRISE_NODES),
+        "remaining_baseline_failures": sorted(remaining_failures),
+        "protected_contracts": PROTECTED,
+        "scope": "isolated_recovery_only_no_main_merge_no_deploy",
+    }
+    if transactional_v2:
+        receipt["enterprise_atomic_tests_passed"] = len(SCOPE_V2_REQUIRED_ATOMIC_NODES)
+        receipt["scope_ratified"] = SCOPE_V2_SCHEMA
+    return receipt
+
