+def run(args: argparse.Namespace) -> dict:
+    repo = args.repo.resolve()
+    if _git(repo, "branch", "--show-current") != RECOVERY_BRANCH:
+        raise RecoveryGateError("WRONG_RECOVERY_BRANCH")
+    if _git(repo, "rev-parse", BASELINE_SHA) != BASELINE_SHA:
+        raise RecoveryGateError("BASELINE_COMMIT_UNAVAILABLE")
+    with args.approved_manifest.open(encoding="utf-8") as handle:
+        approved = json.load(handle)
+    if not isinstance(approved, dict):
+        raise RecoveryGateError("APPROVED_MANIFEST_INVALID")
+    try:
+        actual_environment = {
+            "python": platform.python_version(),
+            "fastapi": version("fastapi"),
+            "pydantic": version("pydantic"),
+        }
+    except PackageNotFoundError as exc:
+        raise RecoveryGateError("TEST_DEPENDENCIES_NOT_INSTALLED") from exc
+    if approved.get("environment") != actual_environment:
+        raise RecoveryGateError("TEST_ENVIRONMENT_DRIFT")
+    _verify_junit_digest(args.baseline_junit, approved.get("baseline_junit_sha256"))
+    changed = set(_git(repo, "diff", "--name-only", BASELINE_SHA).splitlines())
+    changed.update(_git(repo, "ls-files", "--others", "--exclude-standard").splitlines())
+    hashes = {path: _git(repo, "hash-object", path) for path in PROTECTED}
+    if approved.get("schema_version") == SCOPE_V2_SCHEMA:
+        source_hashes = {
+            path: _git(repo, "hash-object", path)
+            for path in SCOPE_V2_CANDIDATE_SOURCE_BLOBS
+        }
+        if source_hashes != SCOPE_V2_CANDIDATE_SOURCE_BLOBS:
+            raise RecoveryGateError("CANDIDATE_SOURCE_BLOB_DIVERGENCE")
+        provenance_path = repo / "docs/B03_B04_BLOB_PROVENIENCE_20261118.json"
+        try:
+            with provenance_path.open(encoding="utf-8") as handle:
+                provenance = json.load(handle)
+            sources = provenance["items"]
+        except (OSError, ValueError, KeyError, TypeError) as exc:
+            raise RecoveryGateError("SOURCE_PROVENANCE_MANIFEST_INVALID") from exc
+        if len(sources) != 36 or any(
+            type(x) is not dict
+            or _git(repo, "hash-object", x.get("path", "")) != x.get("git_blob")
+            for x in sources
+        ):
+            raise RecoveryGateError("SOURCE_BLOB_PROVENANCE_DIVERGENCE")
+    harness_hashes = {
+        path: _git(repo, "hash-object", path) for path in BASELINE_HARNESS_OVERLAY
+    }
+    return evaluate(
+        baseline=parse_junit(args.baseline_junit),
+        candidate=parse_junit(args.candidate_junit),
+        approved=approved, contract_hashes=hashes, changed_paths=changed,
+        harness_hashes=harness_hashes,
+    )
+
+
+def main(argv: list[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--repo", type=Path, default=Path("."))
+    parser.add_argument("--baseline-junit", type=Path, required=True)
+    parser.add_argument("--candidate-junit", type=Path, required=True)
+    parser.add_argument("--approved-manifest", type=Path, required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    args = parser.parse_args(argv)
+    try:
+        result = run(args)
+    except (RecoveryGateError, OSError, json.JSONDecodeError) as exc:
+        result = {
+            "schema_version": "SOLVERIS_ENTERPRISE_RECOVERY_GATE_V1",
+            "GLOBAL_GREEN": False,
+            "ENTERPRISE_RECOVERY_STATUS": "BLOCKED",
+            "reason": str(exc).split(":", 1)[0],
+        }
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    args.output.write_text(json.dumps(result, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
+    print(result["ENTERPRISE_RECOVERY_STATUS"])
+    return 0 if result["ENTERPRISE_RECOVERY_STATUS"] == "PASS_WITH_BASELINE_RED" else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
