@@ -0,0 +1,75 @@
+"""Catraca V4.2: sucessao explicita, sem editar as provas predecessoras."""
+from __future__ import annotations
+
+import importlib.util
+import json
+from pathlib import Path
+import unittest
+from unittest.mock import patch
+
+ROOT = Path(__file__).resolve().parents[1]
+SPEC = importlib.util.spec_from_file_location(
+    "enterprise_recovery_v42_gate_under_test",
+    ROOT / "tools/enterprise_recovery_test_gate_v42.py",
+)
+assert SPEC and SPEC.loader
+gate = importlib.util.module_from_spec(SPEC)
+SPEC.loader.exec_module(gate)
+
+
+class TestRecoveryGateV42(unittest.TestCase):
+    def setUp(self):
+        self.approved = json.loads((ROOT / gate.MANIFEST).read_text(encoding="utf-8"))
+
+    def test_01_v42_83_nodos_e_manifesto_sem_green(self):
+        gate._validate_manifest(ROOT, self.approved, require_commit=False)
+        self.assertEqual(len(gate._nodes(ROOT)), 83)
+        self.assertIs(self.approved["GLOBAL_GREEN"], False)
+        self.assertEqual(self.approved["modified_v411_paths"], sorted(gate.OVERRIDES))
+
+    def test_02_manifesto_forjado_ou_nao_ratifcado_reprovado(self):
+        with self.assertRaisesRegex(gate.v2.RecoveryGateError,
+                                    "SCOPE_V42_UNRATIFIED_OR_EXPANDED"):
+            gate._validate_manifest(
+                ROOT, dict(self.approved, GLOBAL_GREEN=True), require_commit=False
+            )
+        with self.assertRaisesRegex(gate.v2.RecoveryGateError,
+                                    "SCOPE_V42_MANIFEST_FINGERPRINT_DIVERGED"):
+            gate._validate_manifest(
+                ROOT, dict(self.approved, nova_autoridade=True), require_commit=False
+            )
+
+    def test_03_caminho_de_producao_nao_ratificado_bloqueia(self):
+        with self.assertRaisesRegex(gate.v2.RecoveryGateError,
+                                    "SCOPE_V42_UNAPPROVED_PATH_CHANGED"):
+            gate.verify_sources(
+                repo=ROOT, v3_manifest={}, v4_manifest={},
+                v41_manifest={}, v411_manifest={}, v42_manifest=self.approved,
+                changed={"app/mei/nao_autorizado.py"}, observed={},
+            )
+
+    def test_04_um_novo_red_impede_o_gate_sem_falso_green(self):
+        def doc(path):
+            return json.loads((ROOT / path).read_text(encoding="utf-8"))
+
+        with patch.object(gate, "_validate_manifest"):
+            with patch.object(gate, "verify_sources"):
+                with patch.object(gate, "_nodes", return_value={"NOVO::RED"}):
+                    with self.assertRaisesRegex(
+                        gate.v2.RecoveryGateError, "SCOPE_V42_TESTS_RED"
+                    ):
+                        gate.evaluate_v42(
+                            repo=ROOT, baseline={},
+                            candidate={"NOVO::RED": ("failure", "", "")},
+                            approved_v2=doc("docs/B03_B04_BASELINE_ESCOPO_TRANSACIONAL_V2_20261118.json"),
+                            approved_v3=doc("docs/B03_B04_BASELINE_ESCOPO_G1_V3_20261118.json"),
+                            approved_v4=doc(gate.v4.MANIFEST),
+                            approved_v41=doc(gate.v41.MANIFEST),
+                            approved_v411=doc(gate.v411.MANIFEST),
+                            approved_v42=self.approved, changed=set(), observed={},
+                            harness={}, require_commit=False,
+                        )
+
+
+if __name__ == "__main__":
+    unittest.main()
