@@ -0,0 +1,116 @@
+"""V4.2: observacao XML-parser G12 alimenta G1 privado sem falsa autoridade.
+
+Original B01 PR e segundo RS exercitam motores reais. Os negativos provam
+que um marcador isolado, origem não autorizada ou valor divergente nao produz
+pares numéricos nem desbloqueia politica fiscal.
+"""
+from __future__ import annotations
+
+from unittest import TestCase
+from unittest.mock import patch
+
+from app.services import enterprise_g12_st_item_reconciliation as g12
+import test_solveris_b01_circuit as b01
+import test_enterprise_g12_xml_parser_v41_contract as rs
+
+
+class TestEnterpriseG12G1XmlObservationV42(TestCase):
+    def _fixture(self, cls, name):
+        fixture = cls(name)
+        fixture.setUp()
+        self.addCleanup(fixture.tearDown)
+        return fixture
+
+    def test_01_pr_original_g1_compara_dois_pares_sem_autoridade(self):
+        f = self._fixture(
+            b01.TestEnterpriseB01SyntheticIntegration,
+            "test_01_circuito_real_writer_i2_g12_g14_adr020_c3_c7",
+        )
+        self.assertNotIn("st_observado_xml", g12.ler_xml_unico(xml_bytes=f.raw)["itens"][0])
+        result = g12.confrontar_st_por_item_g12(db=f.db, xml_bytes=f.raw)
+        self.assertEqual(result["itens_simulados"], 1)
+        compare = result["confronto_g1"]
+        self.assertEqual(compare["estado"], "COMPARACAO_NUMERICA_SEM_AUTORIDADE")
+        self.assertEqual({row["tipo"] for row in compare["comparacoes"]},
+                         {"BASE_ST", "ICMS_ST"})
+        self.assertIsNone(compare["consistente"])
+        self.assertIs(result["autoridade_fiscal"], False)
+
+    def test_02_rs_independente_g1_compara_valores_diferentes(self):
+        f = self._fixture(
+            rs.TestEnterpriseG12XmlParserV41,
+            "test_01_segundo_cenario_rs_valores_novos_simula_sem_autoridade",
+        )
+        result = g12.confrontar_st_por_item_g12(db=f.db, xml_bytes=f.raw)
+        self.assertEqual(result["itens_simulados"], 1)
+        compare = result["confronto_g1"]
+        pairs = {row["tipo"]: row for row in compare["comparacoes"]}
+        self.assertEqual(set(pairs), {"BASE_ST", "ICMS_ST"})
+        self.assertEqual(pairs["BASE_ST"]["valor_xml"], "280.00")
+        self.assertEqual(pairs["ICMS_ST"]["valor_xml"], "13.60")
+        self.assertIs(compare["autoridade_fiscal"], False)
+
+    def test_03_rs_base_st_ausente_sem_pares(self):
+        f = self._fixture(
+            rs.TestEnterpriseG12XmlParserV41,
+            "test_04_st_xml_ausente_falha_fechado",
+        )
+        broken = f.raw.replace(b"<vBCST>280.00</vBCST>", b"")
+        result = g12.confrontar_st_por_item_g12(db=f.db, xml_bytes=broken)
+        self.assertEqual(result["itens_simulados"], 0)
+        self.assertEqual(result["confronto_g1"]["comparacoes_realizadas"], 0)
+        self.assertIs(result["checkout_autorizado"], False)
+
+    def test_04_rs_marcador_normativo_ausente_nao_basta_para_par(self):
+        f = self._fixture(
+            rs.TestEnterpriseG12XmlParserV41,
+            "test_03_marcador_ausente_mantem_bloqueio_normativo_rs",
+        )
+        row = f.db.get(rs.TabelaMVA, 191)
+        row.importado_por = "PROVENIENCIA_NAO_ELEGIVEL"
+        f.db.commit()
+        result = g12.confrontar_st_por_item_g12(db=f.db, xml_bytes=f.raw)
+        self.assertEqual(result["itens_simulados"], 0)
+        self.assertEqual(result["confronto_g1"]["comparacoes_realizadas"], 0)
+        self.assertIs(result["autoridade_fiscal"], False)
+
+    def test_05_rs_parser_divergente_nao_inventa_pares(self):
+        f = self._fixture(
+            rs.TestEnterpriseG12XmlParserV41,
+            "test_06_divergencia_parser_real_vs_xml_falha_fechado",
+        )
+        real = g12.ler_xml_unico
+
+        def divergent(*, xml_bytes):
+            parsed = real(xml_bytes=xml_bytes)
+            parsed["itens"][0]["base_st"] = "281.00"
+            return parsed
+
+        with patch.object(g12, "ler_xml_unico", side_effect=divergent):
+            result = g12.confrontar_st_por_item_g12(db=f.db, xml_bytes=f.raw)
+        self.assertEqual(result["itens_simulados"], 0)
+        self.assertEqual(result["confronto_g1"]["comparacoes_realizadas"], 0)
+
+    def test_06_marcador_st_forjado_com_divergencia_continua_fechado(self):
+        f = self._fixture(
+            rs.TestEnterpriseG12XmlParserV41,
+            "test_06_divergencia_parser_real_vs_xml_falha_fechado",
+        )
+        real = g12.ler_xml_unico
+
+        def forged(*, xml_bytes):
+            parsed = real(xml_bytes=xml_bytes)
+            parsed["itens"][0]["valor_st"] = "99.99"
+            parsed["itens"][0]["st_observado_xml"] = True
+            return parsed
+
+        with patch.object(g12, "ler_xml_unico", side_effect=forged):
+            result = g12.confrontar_st_por_item_g12(db=f.db, xml_bytes=f.raw)
+        self.assertEqual(result["itens_simulados"], 0)
+        self.assertEqual(result["confronto_g1"]["comparacoes_realizadas"], 0)
+        self.assertIs(result["credito_confirmado"], False)
+
+
+if __name__ == "__main__":
+    import unittest
+    unittest.main()
