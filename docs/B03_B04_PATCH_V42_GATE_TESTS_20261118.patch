+"""Gate V4.2: G12 -> G1 privado, dois pares XML e fixture RS completa.
+
+V2/V3/V4/V4.1/V4.1.1 sao predecessores imutaveis: nao se reinterpreta a
+ratificacao anterior, nem se admite fonte partilhada/MEI ou GLOBAL_GREEN.
+"""
+from __future__ import annotations
+
+import argparse
+import importlib.util
+import json
+import platform
+import subprocess
+import sys
+from importlib.metadata import PackageNotFoundError, version
+from pathlib import Path
+
+_spec = importlib.util.spec_from_file_location(
+    "enterprise_recovery_v411_for_v42",
+    Path(__file__).with_name("enterprise_recovery_test_gate_v411.py"),
+)
+assert _spec and _spec.loader
+v411 = importlib.util.module_from_spec(_spec)
+_spec.loader.exec_module(v411)
+v41, v4, v3, v2 = v411.v41, v411.v4, v411.v3, v411.v2
+
+SCHEMA = "SOLVERIS_ENTERPRISE_RECOVERY_G12_SCOPE_V42"
+MANIFEST = "docs/B03_B04_BASELINE_ESCOPO_G12_V42_20261118.json"
+V411_MANIFEST_BLOB = "9e83c45623c168c292fb1d8136db0a003f7ed8f0"
+V411_GATE_BLOB = "0ea401f454626e551ebf3880cc46553db594a521"
+G12_V41_BLOB = "13ef36fe50ed55086092ca81b3c5f7f2c4ec07ae"
+G12_V42_BLOB = "8fb2559b093d2435f7395936cedb6f7ad4186ca3"
+RS_V41_BLOB = "4d2fcf95db9156bbf286dfe0ecce1ece7dca7e7c"
+RS_V42_BLOB = "70050471a5dddb25d4ac580fc4e79bacffa4fc3a"
+GUARD_V41_BLOB = "d4d04241bf34561951a4542fee9400f58cecc1f3"
+GUARD_V42_BLOB = "0790c450cc9426ac68ec764faae9bfb6cbaa2c42"
+MANIFEST_FINGERPRINT = "da63097b9c22adae7ee299cf7958df2127cdd20b05585eb8d94f90b3012c3d49"
+
+PRODUCT = "app/services/enterprise_g12_st_item_reconciliation.py"
+RS = "tests/test_enterprise_g12_xml_parser_v41_contract.py"
+GUARD = "tests/recovery_v3_snapshot_guard.py"
+OVERRIDES = frozenset({PRODUCT, RS, GUARD})
+EXTRA = frozenset({
+    "docs/B03_B04_STOP_V411_FUNCIONAIS_G12_20261118.md",
+    "docs/B03_B04_BASELINE_ESCOPO_G12_V42_20261118.json",
+    "docs/B03_B04_EXECUCAO_G12_V42_20261118.md",
+    "docs/B03_B04_PATCH_G12_V42_PRODUTO_20261118.patch",
+    "docs/B03_B04_PATCH_V42_GATE_TESTS_20261118.patch",
+    "docs/B03_B04_RESULTADO_GATE_V42_20261118.json",
+    "tests/test_enterprise_g12_g1_xml_observation_v42_contract.py",
+    "tests/test_enterprise_recovery_scope_v42_gate.py",
+    "tools/enterprise_recovery_test_gate_v42.py",
+})
+PINNED = frozenset(
+    set(v411.PINNED) | {
+        "tests/test_enterprise_g12_g1_xml_observation_v42_contract.py",
+        "tests/test_enterprise_recovery_scope_v42_gate.py",
+        "docs/B03_B04_PATCH_G12_V42_PRODUTO_20261118.patch",
+    }
+)
+EXTRA_TESTS = {
+    "tests.test_enterprise_g12_g1_xml_observation_v42_contract.TestEnterpriseG12G1XmlObservationV42": 6,
+    "tests.test_enterprise_recovery_scope_v42_gate.TestRecoveryGateV42": 4,
+}
+
+
+def _fingerprint(data: dict) -> str:
+    copy = dict(data)
+    copy.pop("gate_self_blob", None)
+    return v2._canonical_digest(copy)
+
+
+def _validate_manifest(repo: Path, data: dict, *, require_commit=True) -> None:
+    if (data.get("schema_version") != SCHEMA
+            or data.get("GLOBAL_GREEN") is not False
+            or data.get("parent_v411_manifest_blob") != V411_MANIFEST_BLOB
+            or data.get("parent_v411_gate_blob") != V411_GATE_BLOB
+            or data.get("preserved_v41_g12_blob") != G12_V41_BLOB
+            or data.get("candidate_g12_blob") != G12_V42_BLOB
+            or data.get("preserved_rs_fixture_blob") != RS_V41_BLOB
+            or data.get("candidate_rs_fixture_blob") != RS_V42_BLOB
+            or data.get("preserved_historical_guard_blob") != GUARD_V41_BLOB
+            or data.get("candidate_historical_guard_blob") != GUARD_V42_BLOB
+            or data.get("original_b01_test_blob") != v4.ORIGINAL_B01_BLOB
+            or data.get("extra_paths") != sorted(EXTRA)
+            or data.get("modified_v411_paths") != sorted(OVERRIDES)
+            or set(data.get("candidate_source_blobs", {})) != PINNED):
+        raise v2.RecoveryGateError("SCOPE_V42_UNRATIFIED_OR_EXPANDED")
+    if _fingerprint(data) != MANIFEST_FINGERPRINT:
+        raise v2.RecoveryGateError("SCOPE_V42_MANIFEST_FINGERPRINT_DIVERGED")
+    if require_commit and (v2._git(repo, "hash-object", MANIFEST)
+                           != v2._git(repo, "rev-parse", "HEAD:" + MANIFEST)):
+        raise v2.RecoveryGateError("SCOPE_V42_MANIFEST_UNCOMMITTED")
+
+
+def _nodes(repo: Path) -> set[str]:
+    nodes = v411._nodes(repo)
+    for prefix, count in EXTRA_TESTS.items():
+        module, classname = prefix.rsplit(".", 1)
+        names = v3._test_names(repo / (module.replace(".", "/") + ".py"),
+                               classname, "")
+        if len(names) != count:
+            raise v2.RecoveryGateError("SCOPE_V42_TEST_COUNT_DIVERGED")
+        nodes.update(prefix + "::" + name for name in names)
+    return nodes
+
+
+def verify_sources(*, repo: Path, v3_manifest: dict, v4_manifest: dict,
+                   v41_manifest: dict, v411_manifest: dict, v42_manifest: dict,
+                   changed: set[str], observed: dict[str, str]) -> None:
+    allowed = (v4.v2_manifest_paths(repo) | set(v3.V3_DELTA)
+               | set(v4.V4_DELTA) | set(v41.EXTRA) | set(v411.EXTRA)
+               | set(EXTRA))
+    if changed - allowed:
+        raise v2.RecoveryGateError("SCOPE_V42_UNAPPROVED_PATH_CHANGED")
+    required = (set(v3.V3_DELTA) | set(v4.V4_DELTA) | set(v41.EXTRA)
+                | set(v411.EXTRA) | set(EXTRA) | set(OVERRIDES))
+    if not required.issubset(changed):
+        raise v2.RecoveryGateError("SCOPE_V42_REQUIRED_PATH_MISSING")
+    if observed != v42_manifest["candidate_source_blobs"]:
+        raise v2.RecoveryGateError("SCOPE_V42_SOURCE_BLOB_DIVERGENCE")
+    expected = {
+        PRODUCT: G12_V42_BLOB, RS: RS_V42_BLOB, GUARD: GUARD_V42_BLOB,
+        "tests/test_solveris_b01_circuit.py": v4.ORIGINAL_B01_BLOB,
+        "app/services/tax_consistency/tax_consistency_engine.py": v3.SHARED_G1_BLOB,
+        "tools/enterprise_recovery_test_gate_v411.py": V411_GATE_BLOB,
+        "tools/enterprise_recovery_test_gate_v41.py": v411.V41_GATE_BLOB,
+        "tools/enterprise_recovery_test_gate_v4.py": v4_manifest["gate_self_blob"],
+        "tools/enterprise_recovery_test_gate_v42.py": v42_manifest["gate_self_blob"],
+    }
+    for path, blob in expected.items():
+        if v2._git(repo, "hash-object", path) != blob:
+            raise v2.RecoveryGateError("SCOPE_V42_PROTECTED_BLOB_DIVERGED:" + path)
+    for prior in (v3_manifest, v4_manifest, v41_manifest, v411_manifest):
+        for path, blob in prior["candidate_source_blobs"].items():
+            target = (G12_V42_BLOB if path == PRODUCT
+                      else RS_V42_BLOB if path == RS
+                      else GUARD_V42_BLOB if path == GUARD
+                      else v411.HISTORY_TEST_NEW_BLOB if path == v411.CORRECTED
+                      else blob)
+            if v2._git(repo, "hash-object", path) != target:
+                raise v2.RecoveryGateError("SCOPE_V42_HISTORICAL_PROVENANCE_CHANGED:" + path)
+    v3.verify_historical_source(repo)
+    origin = json.loads(
+        (repo / "docs/B03_B04_BLOB_PROVENIENCE_20261118.json")
+        .read_text(encoding="utf-8")
+    )
+    entries = origin.get("items", [])
+    if len(entries) != 36 or len({x.get("path") for x in entries if type(x) is dict}) != 36:
+        raise v2.RecoveryGateError("SCOPE_V42_PROVENANCE_COUNT_CHANGED")
+    for row in entries:
+        path = row["path"]
+        blob = (G12_V42_BLOB if path == PRODUCT
+                else v3_manifest["candidate_source_blobs"][path]
+                if path in v3.V3_OVERRIDES else row["git_blob"])
+        if v2._git(repo, "hash-object", path) != blob:
+            raise v2.RecoveryGateError("SCOPE_V42_PROVENANCE_CHANGED:" + path)
+    check = subprocess.run(
+        [sys.executable, str(repo / "tools/check_duplicacao.py"),
+         "--repo", str(repo), "--registro", "docs/REGISTRO_CANONICO.json"],
+        cwd=repo, capture_output=True, text=True, check=False,
+    )
+    if check.returncode:
+        raise v2.RecoveryGateError("SCOPE_V42_DUPLICATION_CHECK_FAILED")
+
+
+def evaluate_v42(*, repo: Path, baseline: dict, candidate: dict,
+                 approved_v2: dict, approved_v3: dict, approved_v4: dict,
+                 approved_v41: dict, approved_v411: dict, approved_v42: dict,
+                 changed: set[str], observed: dict[str, str], harness: dict,
+                 require_commit=True) -> dict:
+    _validate_manifest(repo, approved_v42, require_commit=require_commit)
+    parents = {
+        v411.MANIFEST: V411_MANIFEST_BLOB,
+        v41.MANIFEST: v411.V41_MANIFEST_BLOB,
+        v4.MANIFEST: v41.V4_MANIFEST_BLOB,
+        "docs/B03_B04_BASELINE_ESCOPO_G1_V3_20261118.json": v4.PARENT_V3_BLOB,
+        "docs/B03_B04_BASELINE_ESCOPO_TRANSACIONAL_V2_20261118.json": v3.V2_MANIFEST_BLOB,
+    }
+    for path, blob in parents.items():
+        if v2._git(repo, "hash-object", path) != blob:
+            raise v2.RecoveryGateError("SCOPE_V42_PARENT_CHANGED:" + path)
+    if (v411._fingerprint(approved_v411) != v411.MANIFEST_FINGERPRINT
+            or v41._fingerprint(approved_v41) != v41.MANIFEST_FINGERPRINT
+            or v4._ratified_fingerprint(approved_v4) != v4.RATIFIED_MANIFEST_FINGERPRINT
+            or v2._canonical_digest(approved_v3) != v3.MANIFEST_FINGERPRINT):
+        raise v2.RecoveryGateError("SCOPE_V42_PARENT_FINGERPRINT_DIVERGED")
+    verify_sources(
+        repo=repo, v3_manifest=approved_v3, v4_manifest=approved_v4,
+        v41_manifest=approved_v41, v411_manifest=approved_v411,
+        v42_manifest=approved_v42, changed=changed, observed=observed,
+    )
+    nodes = _nodes(repo)
+    if nodes - set(candidate):
+        raise v2.RecoveryGateError("SCOPE_V42_TESTS_MISSING")
+    if any(candidate[name][0] != "passed" for name in nodes):
+        raise v2.RecoveryGateError("SCOPE_V42_TESTS_RED")
+    result = v2.evaluate(
+        baseline=baseline, candidate=candidate, approved=approved_v2,
+        contract_hashes={p: v2._git(repo, "hash-object", p) for p in v2.PROTECTED},
+        changed_paths=(changed - set(v3.V3_DELTA) - set(v4.V4_DELTA)
+                       - set(v41.EXTRA) - set(v411.EXTRA) - set(EXTRA)),
+        harness_hashes=harness,
+    )
+    result.update({
+        "schema_version": "SOLVERIS_ENTERPRISE_RECOVERY_GATE_V42",
+        "scope_ratified": SCHEMA,
+        "historical_v411_preserved": V411_MANIFEST_BLOB,
+        "original_b01_tests_preserved": 25,
+        "g12_v42_xml_parser_g1_positive_and_negative": 6,
+        "GLOBAL_GREEN": False,
+    })
+    return result
+
+
+def run(args):
+    repo = args.repo.resolve()
+    if v2._git(repo, "branch", "--show-current") != v2.RECOVERY_BRANCH:
+        raise v2.RecoveryGateError("WRONG_RECOVERY_BRANCH")
+    if v2._git(repo, "rev-parse", v2.BASELINE_SHA) != v2.BASELINE_SHA:
+        raise v2.RecoveryGateError("BASELINE_COMMIT_UNAVAILABLE")
+    try:
+        env = {"python": platform.python_version(),
+               "fastapi": version("fastapi"), "pydantic": version("pydantic")}
+    except PackageNotFoundError as exc:
+        raise v2.RecoveryGateError("TEST_DEPENDENCIES_NOT_INSTALLED") from exc
+    approved_v2 = json.loads((repo / "docs/B03_B04_BASELINE_ESCOPO_TRANSACIONAL_V2_20261118.json").read_text())
+    approved_v3 = json.loads((repo / "docs/B03_B04_BASELINE_ESCOPO_G1_V3_20261118.json").read_text())
+    approved_v4 = json.loads((repo / v4.MANIFEST).read_text())
+    approved_v41 = json.loads((repo / v41.MANIFEST).read_text())
+    approved_v411 = json.loads((repo / v411.MANIFEST).read_text())
+    approved_v42 = json.loads(args.approved_manifest.read_text())
+    if approved_v2.get("environment") != env:
+        raise v2.RecoveryGateError("TEST_ENVIRONMENT_DRIFT")
+    v2._verify_junit_digest(args.baseline_junit, approved_v2["baseline_junit_sha256"])
+    changed = set(v2._git(repo, "diff", "--name-only", v2.BASELINE_SHA).splitlines())
+    changed.update(v2._git(repo, "ls-files", "--others", "--exclude-standard").splitlines())
+    observed = {path: v2._git(repo, "hash-object", path) for path in PINNED}
+    harness = {path: v2._git(repo, "hash-object", path) for path in v2.BASELINE_HARNESS_OVERLAY}
+    return evaluate_v42(
+        repo=repo, baseline=v2.parse_junit(args.baseline_junit),
+        candidate=v2.parse_junit(args.candidate_junit),
+        approved_v2=approved_v2, approved_v3=approved_v3,
+        approved_v4=approved_v4, approved_v41=approved_v41,
+        approved_v411=approved_v411, approved_v42=approved_v42,
+        changed=changed, observed=observed, harness=harness,
+    )
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--repo", type=Path, default=Path("."))
+    parser.add_argument("--baseline-junit", type=Path, required=True)
+    parser.add_argument("--candidate-junit", type=Path, required=True)
+    parser.add_argument("--approved-manifest", type=Path, required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    args = parser.parse_args(argv)
+    try:
+        result = run(args)
+    except (v2.RecoveryGateError, OSError, json.JSONDecodeError, KeyError,
+            ValueError, TypeError) as exc:
+        result = {
+            "schema_version": "SOLVERIS_ENTERPRISE_RECOVERY_GATE_V42",
+            "GLOBAL_GREEN": False,
+            "ENTERPRISE_RECOVERY_STATUS": "BLOCKED",
+            "reason": str(exc).split(":", 1)[0],
+        }
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    args.output.write_text(json.dumps(result, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
+    print(result["ENTERPRISE_RECOVERY_STATUS"])
+    return 0 if result["ENTERPRISE_RECOVERY_STATUS"] == "PASS_WITH_BASELINE_RED" else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
