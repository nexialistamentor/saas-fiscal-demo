@@ -0,0 +1,120 @@
+"""V4.3: regressões negativas reais, sem substituir os contratos históricos."""
+from __future__ import annotations
+
+import ast
+import json
+from pathlib import Path
+import unittest
+from unittest.mock import patch
+
+from recovery_v3_snapshot_guard import (
+    G19_TEST_PATH,
+    G19_TEST_V43_BLOB,
+    verify_g19_test_only_successor,
+)
+from tests.test_solveris_mei_vercel_routing_contract_red import (
+    test_legacy_mei_route_is_not_reopened,
+)
+
+
+ROOT = Path(__file__).resolve().parents[1]
+B01 = ROOT / "app/services/registro_analise_service.py"
+
+
+def _b01_insight_guarded(source: str) -> list[ast.If]:
+    tree = ast.parse(source)
+    service = next(
+        node for node in tree.body
+        if isinstance(node, ast.FunctionDef)
+        and node.name == "executar_e_registrar_analise_xml"
+    )
+    result = []
+    for node in ast.walk(service):
+        if not (
+            isinstance(node, ast.If)
+            and isinstance(node.test, ast.Name)
+            and node.test.id == "empresa_id"
+        ):
+            continue
+        if any(
+            isinstance(child, ast.Call)
+            and isinstance(child.func, ast.Attribute)
+            and child.func.attr == "gerar_insights_empresa"
+            for child in ast.walk(node)
+        ):
+            result.append(node)
+    return result
+
+
+class TestRecoveryV43DeltaGate(unittest.TestCase):
+    def test_b01_guarda_externa_preserva_lineage_mei(self):
+        guards = _b01_insight_guarded(B01.read_text(encoding="utf-8"))
+        self.assertEqual(len(guards), 1)
+        self.assertTrue(any(
+            isinstance(child, ast.If)
+            and isinstance(child.test, ast.UnaryOp)
+            and isinstance(child.test.op, ast.Not)
+            and isinstance(child.test.operand, ast.Name)
+            and child.test.operand.id == "enterprise_opt_in"
+            for child in ast.walk(guards[0])
+        ))
+
+    def test_b01_condicao_boolop_antiga_reprovada(self):
+        original = B01.read_text(encoding="utf-8")
+        before = "    if empresa_id:\n        if not enterprise_opt_in:"
+        self.assertEqual(original.count(before), 1)
+        tampered = original.replace(
+            before,
+            "    if empresa_id and not enterprise_opt_in:\n        if not enterprise_opt_in:",
+            1,
+        )
+        self.assertEqual(_b01_insight_guarded(tampered), [])
+
+    def test_g19_sucessor_test_only_reconstitui_bytes_v3(self):
+        def observed(_repo, command, path):
+            self.assertEqual((command, path), ("hash-object", G19_TEST_PATH))
+            return G19_TEST_V43_BLOB
+
+        self.assertTrue(verify_g19_test_only_successor(ROOT, observed))
+
+    def test_g19_sucessor_sem_prova_falha_fechado(self):
+        with self.assertRaisesRegex(AssertionError, "BLOB_NAO_RATIFICADO"):
+            verify_g19_test_only_successor(ROOT, lambda *_: "0" * 40)
+
+        original = Path.read_bytes
+
+        def tampered_read(path):
+            data = original(path)
+            if path == ROOT / G19_TEST_PATH:
+                return data + b"\n# adulterado"
+            return data
+
+        with patch.object(Path, "read_bytes", tampered_read):
+            with self.assertRaisesRegex(AssertionError, "HISTORICO_NAO_RECONSTITUIDO"):
+                verify_g19_test_only_successor(
+                    ROOT, lambda *_: G19_TEST_V43_BLOB
+                )
+
+    def test_vercel_hold_impede_true_em_main_ou_branch(self):
+        original = Path.read_text
+        config = json.loads((ROOT / "frontend-dashboard/vercel.json").read_text())
+        flags = config["git"]["deploymentEnabled"]
+        self.assertFalse(flags["main"])
+        self.assertFalse(flags["recovery/enterprise-b00-b04-20261117"])
+
+        for branch in ("main", "recovery/enterprise-b00-b04-20261117"):
+            altered = json.loads(json.dumps(config))
+            altered["git"]["deploymentEnabled"][branch] = True
+
+            def read_config(path, *args, **kwargs):
+                if path == ROOT / "frontend-dashboard/vercel.json":
+                    return json.dumps(altered)
+                return original(path, *args, **kwargs)
+
+            with patch.object(Path, "read_text", read_config):
+                with self.assertRaises(AssertionError):
+                    test_legacy_mei_route_is_not_reopened()
+
+
+if __name__ == "__main__":
+    unittest.main()
