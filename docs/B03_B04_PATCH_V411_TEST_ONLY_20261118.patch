diff --git a/tests/test_enterprise_recovery_scope_v411_gate.py b/tests/test_enterprise_recovery_scope_v411_gate.py
new file mode 100644
index 00000000..f2d15f3c
--- /dev/null
+++ b/tests/test_enterprise_recovery_scope_v411_gate.py
@@ -0,0 +1,52 @@
+"""Controles V4.1.1: sucesso do Windows exige nova versao, sem relabel V4.1."""
+from __future__ import annotations
+
+import importlib.util
+import json
+from pathlib import Path
+import unittest
+
+ROOT = Path(__file__).resolve().parents[1]
+SPEC = importlib.util.spec_from_file_location(
+    "recovery_v411_test", ROOT / "tools/enterprise_recovery_test_gate_v411.py"
+)
+assert SPEC and SPEC.loader
+gate = importlib.util.module_from_spec(SPEC)
+SPEC.loader.exec_module(gate)
+
+
+class TestRecoveryGateV411(unittest.TestCase):
+    def setUp(self):
+        self.manifest = json.loads((ROOT / gate.MANIFEST).read_text(encoding="utf-8"))
+
+    def test_01_v411_apenas_um_teste_corrigido_sem_green(self):
+        gate._validate_manifest(ROOT, self.manifest, require_commit=False)
+        self.assertEqual(self.manifest["modified_v41_paths"], [gate.CORRECTED])
+        self.assertIs(self.manifest["GLOBAL_GREEN"], False)
+        self.assertEqual(len(gate._nodes(ROOT)), 73)
+
+    def test_02_v411_rejeita_manifesto_malicioso(self):
+        with self.assertRaisesRegex(gate.v2.RecoveryGateError,
+                                    "SCOPE_V411_UNRATIFIED_OR_EXPANDED"):
+            gate._validate_manifest(
+                ROOT, dict(self.manifest, GLOBAL_GREEN=True), require_commit=False
+            )
+        with self.assertRaisesRegex(gate.v2.RecoveryGateError,
+                                    "SCOPE_V411_MANIFEST_FINGERPRINT_DIVERGED"):
+            gate._validate_manifest(
+                ROOT, dict(self.manifest, extra="nao_ratificado"), require_commit=False
+            )
+
+    def test_03_v41_anterior_permanece_congelada_e_nao_admite_delta(self):
+        old = json.loads((ROOT / gate.v41.MANIFEST).read_text(encoding="utf-8"))
+        self.assertEqual(gate.v2._git(ROOT, "hash-object", gate.v41.MANIFEST),
+                         gate.V41_MANIFEST_BLOB)
+        self.assertEqual(gate.v2._git(ROOT, "hash-object", gate.CORRECTED),
+                         gate.HISTORY_TEST_NEW_BLOB)
+        self.assertEqual(old["candidate_source_blobs"][gate.CORRECTED],
+                         gate.HISTORY_TEST_OLD_BLOB)
+        self.assertNotEqual(gate.HISTORY_TEST_NEW_BLOB, gate.HISTORY_TEST_OLD_BLOB)
+
+
+if __name__ == "__main__":
+    unittest.main()

diff --git a/tools/enterprise_recovery_test_gate_v411.py b/tools/enterprise_recovery_test_gate_v411.py
