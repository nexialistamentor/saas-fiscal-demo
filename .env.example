# .env.example — Plataforma Tributária L2
# Copiar para .env e preencher os valores reais antes de correr localmente.
# NUNCA commitar .env com valores reais.
# Variáveis obrigatórias em produção marcadas com [OBRIGATÓRIO].

# ── Core ────────────────────────────────────────────────────────────────
# [OBRIGATÓRIO] URL da base de dados PostgreSQL em produção.
DATABASE_URL=sqlite:///./test.db

# [OBRIGATÓRIO] Ambiente de execução. Em produção, usar "production".
# Valores: development | production
ENVIRONMENT=development

# [OBRIGATÓRIO em produção] Chave secreta principal para JWT.
# Gerar com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-insecure-placeholder-DO-NOT-USE-IN-PROD

# Chaves secretas rotativas para JWT (multi-key rotation) — opcional/futuro.
# Só usar se o código estiver configurado para multi-key rotation.
# Formato: kid1:secret1,kid2:secret2
SECRET_KEYS=

# ── Redis / RQ ───────────────────────────────────────────────────────────
# URL do Redis para fila de análise XML assíncrona.
# Se ausente, análises correm de forma síncrona (fallback garantido).
REDIS_URL=

# ── Comportamento de análise XML ─────────────────────────────────────────
# Forçar análise XML síncrona (sem Redis), mesmo que Redis esteja disponível.
# Valores: 1 | true | yes | on  (qualquer outro valor = assíncrono)
ANALISE_XML_INLINE=

# ── Logs e retenção ──────────────────────────────────────────────────────
# Número de dias de retenção dos request_logs. 0 = desactivar purge.
REQUEST_LOG_RETENTION_DAYS=30

# ── Registo de utilizadores ───────────────────────────────────────────────
# Permitir registo sem restrição (útil em desenvolvimento).
# Em produção, deixar vazio para aplicar regras normais.
LIBERAR_CONSULTA_REGISTRO=

# ── WhatsApp / Notificações ───────────────────────────────────────────────
# URL e token da API WhatsApp (opcional — notificações).
WHATSAPP_API_URL=
WHATSAPP_TOKEN=

# ── Parsers DOU (Diário Oficial da União) ────────────────────────────────
DOU_DADOS_ABERTOS_ZIP_BASE=
DOU_DADOS_ABERTOS_MAX_DIAS=
DOU_DADOS_ABERTOS_SECOES=

# ── Parsers Inlabs ────────────────────────────────────────────────────────
INLABS_USER=
INLABS_PASS=
INLABS_MAX_DIAS_XML=
INLABS_SECOES_XML=
INLABS_TIMEOUT=120
INLABS_USER_AGENT=

# ── Frontend (Vite) ───────────────────────────────────────────────────────
# URL base da API backend, usada pelo frontend React/Vite.
# Em desenvolvimento: http://localhost:8000
# Em produção: URL pública do Railway
VITE_API_URL=http://localhost:8000

# LLM Router — DeepSeek
LLM_PROVIDER=mock
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_API_KEY=
DEEPSEEK_DRY_RUN=true
DEEPSEEK_TIMEOUT_SECONDS=30

# LLM Budget — B13-OPS-04
LLM_ALLOW_REAL_CALLS=false
LLM_BUDGET_ENABLED=true
LLM_DAILY_MAX_CALLS=20
LLM_MONTHLY_MAX_CALLS=300
LLM_MAX_INPUT_CHARS=12000
LLM_REQUIRE_REASON=true
LLM_MAX_OUTPUT_TOKENS=1024

# Kill switches — agentes
AGENTS_ENABLED=false
AGENT_LEARNING_MODE=true
AGENT_AUTO_PATCH=false
AGENT_AUTO_COMMIT=false
AGENT_AUTO_DEPLOY=false

# SERPRO PGMEI secure composition (disabled unless exactly "true").
SERPRO_PGMEI_ENABLED=false
# Credentials and PKCS#12 identity; keep empty in this example.
SERPRO_CONSUMER_KEY=
SERPRO_CONSUMER_SECRET=
SERPRO_PKCS12_FILE=
SERPRO_PKCS12_PASSWORD=
# PGMEI destination and contractor identifier; configure outside source control.
SERPRO_PGMEI_ENDPOINT=
SERPRO_CONTRATANTE=
# Finite timeout/safe-window defaults in seconds.
SERPRO_OAUTH_TIMEOUT=30
SERPRO_PGMEI_TIMEOUT=30
SERPRO_OAUTH_SAFE_WINDOW=30
