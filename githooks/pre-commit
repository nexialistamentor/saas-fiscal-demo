#!/bin/sh
# Pre-commit hook: bloqueia o commit se check_duplicacao.py encontrar
# duplicacao nao declarada ou cobertura parcial. Instalado via
# tools/instalar_hooks.ps1 (este ficheiro vive versionado em githooks/,
# .git/hooks/ nao e versionado pelo git).
#
# Bypass deliberado (ex. commit so de ficheiros nao-Python, ou emergencia
# documentada): git commit --no-verify -- mas isto fica no log do commit,
# nao e silencioso.

REPO_ROOT="$(git rev-parse --show-toplevel)"
REGISTRO="docs/REGISTRO_CANONICO.json"
SCRIPT="tools/check_duplicacao.py"

if [ ! -f "$REPO_ROOT/$SCRIPT" ] || [ ! -f "$REPO_ROOT/$REGISTRO" ]; then
    echo ""
    echo "=========================================================="
    echo "COMMIT BLOQUEADO: catraca anti-duplicacao ausente"
    echo "=========================================================="
    echo "$SCRIPT ou $REGISTRO nao foram encontrados neste branch."
    echo "Isto normalmente significa que o branch foi criado a partir"
    echo "de uma base sem o commit a31ee81b (que introduziu a catraca"
    echo "em B03) -- ou seja, este branch pode estar desatualizado em"
    echo "relacao ao trabalho atual do projeto."
    echo ""
    echo "Confirme antes de continuar:"
    echo "    git log --oneline -1 -- \$SCRIPT"
    echo "    git merge-base HEAD origin/main"
    echo ""
    echo "Bypass deliberado (exige motivo documentado):"
    echo "    git commit --no-verify"
    echo ""
    exit 1
fi

python "$REPO_ROOT/$SCRIPT" --repo "$REPO_ROOT" --registro "$REGISTRO"
STATUS=$?

if [ $STATUS -ne 0 ]; then
    echo ""
    echo "=========================================================="
    echo "COMMIT BLOQUEADO pelo pre-commit hook (check_duplicacao.py)"
    echo "=========================================================="
    echo "Corrija a duplicacao/cobertura parcial acima, ou declare o"
    echo "falso-positivo/substituicao em docs/REGISTRO_CANONICO.json."
    echo ""
    echo "Bypass deliberado (nao recomendado sem motivo documentado):"
    echo "    git commit --no-verify"
    echo ""
    exit 1
fi

exit 0
