{
  "$schema": "https://schema.railpack.com",
  "provider": "python",
  "packages": {
    "python": "3.11"
  },
  "deploy": {
    "aptPackages": [
      "...",
      "tesseract-ocr",
      "tesseract-ocr-eng",
      "tesseract-ocr-por",
      "poppler-utils"
    ],
    "startCommand": "ENVIRONMENT=production PGSSLROOTCERT=config/railway_postgres_root_ca.pem uvicorn app.main:app --host 0.0.0.0 --port $PORT"
  }
}
